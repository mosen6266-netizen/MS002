<Window x:Class="SignalScheduler.Desktop.LinkWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Signal 扫码登录" Width="470" Height="590" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="#07111F" Foreground="#EAF2FF">
 <Grid Margin="24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="18"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="18"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="扫码登录 Signal" FontSize="26" FontWeight="Bold"/>
   <TextBlock Text="使用手机 Signal → 设置 → 已连接的设备 → 连接新设备" Margin="0,8,0,0" Foreground="#9FB2C8" TextWrapping="Wrap"/>
  </StackPanel>
  <Border Grid.Row="2" Width="330" Height="330" Background="White" CornerRadius="8" HorizontalAlignment="Center">
   <Image x:Name="QrImage" Width="310" Height="310" Stretch="Uniform"/>
  </Border>
  <TextBlock Grid.Row="4" x:Name="StatusText" Text="等待扫码…" HorizontalAlignment="Center" FontSize="16" Foreground="#F5C451"/>
  <TextBlock Grid.Row="5" Text="二维码有效时间较短。扫码后请等待程序自动完成设备绑定，不要重复点击扫码登录。" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#8FA7C2"/>
  <Button Grid.Row="6" Content="关闭" Width="100" Padding="12,8" HorizontalAlignment="Right" Click="Close_Click"/>
 </Grid>
</Window>
