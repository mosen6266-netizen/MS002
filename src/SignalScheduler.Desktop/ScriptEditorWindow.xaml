<Window x:Class="SignalScheduler.Desktop.ScriptEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="剧本管理 - Signal 调度台" Width="1370" Height="850"
 MinWidth="1120" MinHeight="690" WindowStartupLocation="CenterOwner"
 Background="#071522" Foreground="#EAF1FA">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="Background" Value="#17324E"/>
   <Setter Property="BorderBrush" Value="#345675"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="Margin" Value="0,0,7,0"/>
   <Setter Property="MinHeight" Value="28"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#10263B"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#46617D"/>
   <Setter Property="Padding" Value="6"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="IsReadOnly" Value="False"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="Background" Value="#0D1B2B"/>
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="RowBackground" Value="#0D1B2B"/>
   <Setter Property="AlternatingRowBackground" Value="#14263A"/>
   <Setter Property="BorderBrush" Value="#385573"/>
   <Setter Property="RowHeaderWidth" Value="0"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="SelectionMode" Value="Single"/>
   <Setter Property="SelectionUnit" Value="FullRow"/>
  </Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="235"/>
   <ColumnDefinition Width="14"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <Border Background="#0B1D30" BorderBrush="#294560"
          BorderThickness="1" Padding="12" CornerRadius="10">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="我的剧本" FontSize="21" FontWeight="SemiBold"/>
     <TextBlock Text="每个剧本单独保存" Foreground="#9BAFC5" Margin="0,4,0,12"/>
     <Button Content="＋ 新建剧本" Click="NewScript_Click" Margin="0,0,0,9"/>
     <Button Content="刷新剧本列表" Click="ReloadScripts_Click" Margin="0,0,0,9"/>
    </StackPanel>
    <ListBox x:Name="ScriptsList" Grid.Row="1" SelectionChanged="ScriptsList_SelectionChanged"
             Background="#0E263D" Foreground="White" BorderBrush="#2D5273"
             DisplayMemberPath="Name"/>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
     <Button Content="导入 JSON 剧本" Click="Import_Click" Margin="0,0,0,8"/>
     <Button Content="导出当前剧本" Click="Export_Click" Margin="0,0,0,8"/>
     <TextBlock Text="从 V7 复制的剧本可编辑，原 V7 数据不会被覆盖。"
                Foreground="#AABDD0" TextWrapping="Wrap" FontSize="12"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Column="2">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="10"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="12"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="12"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="8"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <DockPanel Grid.Row="0" LastChildFill="False">
    <TextBlock Text="剧本编辑器" DockPanel.Dock="Left"
               FontSize="26" FontWeight="SemiBold"/>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button Content="保存剧本" Click="Save_Click" Background="#14784D"/>
     <Button Content="关闭" Click="Close_Click"/>
    </StackPanel>
   </DockPanel>

   <Border Grid.Row="2" Background="#0D2135" Padding="14" BorderBrush="#2B4B6A"
           BorderThickness="1" CornerRadius="8">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="剧本名称" Foreground="#A9C1D9" Margin="0,0,0,6"/>
      <TextBox x:Name="NameBox" FontSize="15" MaxLength="120"
               TextChanged="EditorField_Changed"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="目标群组编号（可留空）" Foreground="#A9C1D9" Margin="0,0,0,6"/>
      <TextBox x:Name="GroupBox" MaxLength="500"
               TextChanged="EditorField_Changed"/>
     </StackPanel>
    </Grid>
   </Border>

   <Grid Grid.Row="4">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10" LastChildFill="False">
     <TextBlock Text="消息列表" DockPanel.Dock="Left"
                VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button Content="添加到末尾" Click="Append_Click"/>
      <Button Content="为选中句导入图片" Click="ImportImage_Click"/>
      <Button Content="预览图片" Click="PreviewImage_Click"/>
      <Button Content="选中上移" Click="MoveUp_Click"/>
      <Button Content="选中下移" Click="MoveDown_Click"/>
     </StackPanel>
    </DockPanel>
    <DataGrid x:Name="StepsGrid" Grid.Row="1" AlternationCount="2"
              CellEditEnding="StepsGrid_CellEditEnding">
     <DataGrid.Columns>
      <DataGridTextColumn Header="序号" Binding="{Binding PositionLabel}" IsReadOnly="True" Width="46"/>
      <DataGridTemplateColumn Header="插入 / 删除" Width="125">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <StackPanel Orientation="Horizontal">
          <Button Content="↑＋" ToolTip="在这句上方插入" Tag="{Binding}" Click="InsertAbove_Click" Padding="4,3" MinHeight="20"/>
          <Button Content="↓＋" ToolTip="在这句下方插入" Tag="{Binding}" Click="InsertBelow_Click" Padding="4,3" MinHeight="20"/>
          <Button Content="×" ToolTip="删除这句话" Tag="{Binding}" Click="DeleteStep_Click" Padding="4,3" MinHeight="20"/>
         </StackPanel>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="账号（可空）" Width="115"
       Binding="{Binding Account,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
      <DataGridTemplateColumn Header="消息内容" Width="2*">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Padding="3"
                    MaxHeight="110"/>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
       <DataGridTemplateColumn.CellEditingTemplate>
        <DataTemplate>
         <TextBox Text="{Binding Message,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" MaxHeight="180"
                  VerticalScrollBarVisibility="Auto"/>
        </DataTemplate>
       </DataGridTemplateColumn.CellEditingTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="间隔秒" Width="70"
       Binding="{Binding DelayText,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
      <DataGridTextColumn Header="输入秒" Width="70"
       Binding="{Binding TypingText,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
      <DataGridCheckBoxColumn Header="暂停提醒" Width="80"
       Binding="{Binding PauseAfter,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
      <DataGridTextColumn Header="提醒内容" Width="160"
       Binding="{Binding ReminderText,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
      <DataGridTextColumn Header="附件路径" Width="140"
       Binding="{Binding Attachment,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>

   <TextBlock Grid.Row="6" x:Name="StatusText" Text="可以新建剧本，也可以选择左侧已有剧本。"
              Foreground="#B6C7DA" TextWrapping="Wrap"/>
   <TextBlock Grid.Row="8"
    Text="注意：当前是剧本管理测试版。每句话可先不指定账号；输入时间和间隔以秒计算。附件路径仅保存文字引用，尚未实现图片打包或实际发送。"
    Foreground="#E9B967" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>
