<UserControl x:Class="SignalScheduler.Desktop.ScriptEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#0B1828" Foreground="#F0F6FD">
 <UserControl.Resources>
  <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ReadableButtonBase}">
   <Setter Property="Background" Value="#1B3A52"/>
   <Setter Property="Foreground" Value="#F5F8FC"/>
   <Setter Property="BorderBrush" Value="#42647C"/>
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="MinHeight" Value="37"/>
   <Setter Property="Margin" Value="0,0,7,0"/>
  </Style>
  <Style x:Key="SmallRowButton" TargetType="Button"
   BasedOn="{StaticResource ActionButton}">
   <Setter Property="MinWidth" Value="31"/>
   <Setter Property="MinHeight" Value="35"/>
   <Setter Property="Padding" Value="2,2"/>
   <Setter Property="Margin" Value="0,0,3,0"/>
  </Style>
  <Style x:Key="ImageAddAction" TargetType="Button" BasedOn="{StaticResource ActionButton}">
   <Setter Property="Background" Value="#28557D"/>
   <Setter Property="BorderBrush" Value="#4B91C7"/>
  </Style>
  <Style x:Key="ImagePreviewAction" TargetType="Button" BasedOn="{StaticResource ActionButton}">
   <Setter Property="Background" Value="#177450"/>
   <Setter Property="BorderBrush" Value="#35AE79"/>
  </Style>
  <Style x:Key="ImageRowButton" TargetType="Button" BasedOn="{StaticResource SmallRowButton}">
   <Setter Property="Background" Value="#244F76"/>
   <Setter Property="BorderBrush" Value="#529AD0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ImageActionFace" Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
       CornerRadius="5" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center"
        VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ImageActionFace" Property="Opacity" Value="0.88"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="ImageActionFace" Property="Opacity" Value="0.75"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ImageActionFace" Property="Background" Value="#333C47"/>
        <Setter TargetName="ImageActionFace" Property="BorderBrush" Value="#677888"/>
        <Setter TargetName="ImageActionFace" Property="Opacity" Value="1"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <DataTrigger Binding="{Binding HasAttachment}" Value="True">
     <Setter Property="Background" Value="#166C4A"/>
     <Setter Property="BorderBrush" Value="#42A77A"/>
     <Setter Property="FontWeight" Value="Bold"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding IsAttachmentBroken}" Value="True">
     <Setter Property="Background" Value="#853944"/>
     <Setter Property="BorderBrush" Value="#DA6971"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ScriptListItem" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="8,9"/>
   <Setter Property="Margin" Value="0,1"/>
   <Setter Property="Foreground" Value="#F0F6FD"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="#276CA2"/>
     <Setter Property="Foreground" Value="#FFFFFF"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="BorderBrush" Value="#7DC9FF"/>
     <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Margin="18">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="235" MinWidth="180" MaxWidth="380"/>
   <ColumnDefinition Width="8"/>
   <ColumnDefinition Width="*" MinWidth="440"/>
  </Grid.ColumnDefinitions>
  <Border Background="#102438" BorderBrush="#31506B"
   BorderThickness="1" CornerRadius="10" Padding="12">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="剧本库" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="选择或新建剧本" Foreground="#AAC3D9" Margin="0,5,0,14"/>
     <TextBox x:Name="ScriptSearchBox" Margin="0,0,0,10" Height="36"
      ToolTip="输入剧本名称关键词；筛选不会清除正在编辑的内容"
      TextChanged="ScriptSearchBox_TextChanged"/>
     <TextBlock x:Name="ScriptSearchSummary" Text="输入名称可搜索剧本"
      Margin="0,0,0,10" Foreground="#A5BED6" FontSize="11"/>
     <Button Content="＋ 新建剧本" Click="NewScript_Click"
      Style="{StaticResource ActionButton}" Margin="0,0,0,8"/>
     <Button Content="刷新列表" Click="ReloadScripts_Click"
      Style="{StaticResource ActionButton}" Margin="0,0,0,6"/>
     <TextBlock Text="按住剧本名称拖动排序（自动保存）"
      FontSize="11" Foreground="#A8C8DC" Margin="0,0,0,7"/>
     <Button x:Name="ExportSelectedZipButton" Content="导出选中剧本 ZIP" Tag="single" Click="ExportBundle_Click"
      Style="{StaticResource ActionButton}" Margin="0,0,0,5"/>
     <Button x:Name="ExportAllZipButton" Content="导出全部剧本 ZIP" Tag="all" Click="ExportBundle_Click"
      Style="{StaticResource ActionButton}" Margin="0,0,0,5"/>
     <Button x:Name="ImportZipButton" Content="导入剧本 ZIP" Click="ImportBundle_Click"
      Style="{StaticResource ActionButton}" Margin="0,0,0,10"/>
    </StackPanel>
    <ListBox x:Name="ScriptsList" Grid.Row="1" PreviewMouseRightButtonDown="ScriptsList_PreviewMouseRightButtonDown"
     PreviewMouseLeftButtonDown="ScriptsList_PreviewMouseLeftButtonDown"
     PreviewMouseMove="ScriptsList_PreviewMouseMove"
     DragOver="ScriptsList_DragOver" Drop="ScriptsList_Drop"
     AllowDrop="True"
     SelectionChanged="ScriptsList_SelectionChanged"
     Background="#132B42" BorderBrush="#3C5B75"
     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
     ItemContainerStyle="{StaticResource ScriptListItem}">
     <ListBox.ContextMenu>
      <ContextMenu><MenuItem Header="重命名剧本" Click="RenameScript_Click"/></ContextMenu>
     </ListBox.ContextMenu>
     <ListBox.ItemTemplate>
      <DataTemplate>
       <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
        TextWrapping="NoWrap" ToolTip="{Binding Name}"
        Foreground="#F0F6FC" VerticalAlignment="Center"/>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
    <Expander Grid.Row="2" Margin="0,8,0,0" IsExpanded="False"
     Foreground="#EAF4FD" Background="#132B42">
     <Expander.Header>
      <TextBlock Text="更多操作 · 导入 / 导出 / 历史 / 图片"
       FontSize="12" Foreground="#D1E7F8" TextWrapping="Wrap"/>
     </Expander.Header>
     <StackPanel Margin="0,9,0,0">
      <Button Content="导入 JSON" Click="Import_Click"
       Style="{StaticResource ActionButton}" Margin="0,0,0,6"/>
      <Button Content="检查当前剧本图片" Click="CheckImages_Click"
       Style="{StaticResource ActionButton}" Margin="0,0,0,6"/>
      <Button Content="查看 / 恢复旧版本" Click="RestoreVersion_Click"
       Style="{StaticResource ActionButton}" Margin="0,0,0,6"/>
      <Button Content="导出当前剧本 JSON（不含图片、不可跨电脑）" Click="Export_Click"
       Style="{StaticResource ActionButton}" Margin="0,0,0,6"/>
      <TextBlock Text="数据保存于本地，升级不会覆盖。"
       FontSize="11" Foreground="#A5BED6" TextWrapping="Wrap"/>
     </StackPanel>
    </Expander>
   </Grid>
  </Border>
  <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
   Width="8" Background="#203D56" ResizeBehavior="PreviousAndNext"
   ShowsPreview="True" ToolTip="拖动调整剧本库和编辑区宽度"/>
  <Grid Grid.Column="2" Margin="12,0,0,0">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="8"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="8"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="12"/>
    <RowDefinition Height="192"/>
    <RowDefinition Height="10"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <StackPanel Grid.Row="0">
    <TextBlock Text="剧本工作台" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="选择消息后可在下方查看并编辑全文"
     FontSize="12" Foreground="#A8C1D8" Margin="0,4,0,7"/>
    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
     <Button Content="保存剧本" Style="{StaticResource ActionButton}"
      Click="Save_Click" Background="#127753" Margin="0,0,7,5"/>
     <Button Content="删除剧本" Style="{StaticResource ActionButton}"
      Click="DeleteScript_Click" Background="#783C45" BorderBrush="#A75D66"
      Margin="0,0,7,5"/>
     <Button Content="返回首页" Style="{StaticResource ActionButton}"
      Click="Close_Click" Margin="0,0,7,5"/>
    </WrapPanel>
   </StackPanel>
   <Border Grid.Row="2" Background="#11273C" BorderBrush="#304D67"
    BorderThickness="1" CornerRadius="8" Padding="12">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="剧本名称" Foreground="#B9D0E4" Margin="0,0,0,5"/>
      <TextBox x:Name="NameBox" MaxLength="120" FontSize="14"
       TextChanged="EditorField_Changed"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="关联群组（可选）" Foreground="#B9D0E4" Margin="0,0,0,5"/>
      <TextBox x:Name="GroupBox" MaxLength="500"
       TextChanged="EditorField_Changed"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="4">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="10"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
     <TextBlock Text="消息列表" FontSize="17" FontWeight="SemiBold"
      Margin="0,0,0,6"/>
     <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
      <Button Content="＋ 加一句" Click="Append_Click" Style="{StaticResource ActionButton}"
       Margin="0,0,6,5"/>
      <Button Content="添加／替换图片" Click="ImportImage_Click" Style="{StaticResource ImageAddAction}"
       Margin="0,0,6,5"/>
      <Button Content="预览图片" Click="PreviewImage_Click" Style="{StaticResource ImagePreviewAction}"
       Margin="0,0,6,5"/>
      <Button Content="向上移动" Click="MoveUp_Click" Style="{StaticResource ActionButton}"
       Margin="0,0,6,5"/>
      <Button Content="向下移动" Click="MoveDown_Click" Style="{StaticResource ActionButton}"
       Margin="0,0,6,5"/>
     </WrapPanel>
    </StackPanel>
    <DataGrid x:Name="StepsGrid" Grid.Row="2" MinHeight="120"
     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
     HeadersVisibility="Column" EnableColumnVirtualization="False"
     MinColumnWidth="46" ScrollViewer.VerticalScrollBarVisibility="Auto"
     AutoGenerateColumns="False" CanUserAddRows="False"
     IsReadOnly="False" RowHeight="48" ColumnHeaderHeight="42"
     ColumnHeaderStyle="{StaticResource DarkGridHeader}"
     AlternationCount="2" RowHeaderWidth="0" SelectionMode="Single"
     SelectionUnit="FullRow" CellEditEnding="StepsGrid_CellEditEnding" PreviewMouseLeftButtonUp="StepsGrid_PreviewMouseLeftButtonUp"
     BorderBrush="#3B5871" Background="#112438" Foreground="#EFF6FD"
     RowBackground="#132D44" AlternatingRowBackground="#1A354C"
     EnableRowVirtualization="True">
     <DataGrid.RowStyle>
      <Style TargetType="DataGridRow">
       <Setter Property="Background" Value="#132D44"/>
       <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
         <Setter Property="Background" Value="#256AA1"/>
         <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
       </Style.Triggers>
      </Style>
     </DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTextColumn Header="#" Width="48" Binding="{Binding PositionLabel}"
       IsReadOnly="True" ElementStyle="{StaticResource TruncatedGridText}"/>
      <DataGridTemplateColumn Header="插入 / 删除" Width="120">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Button Content="↑＋" ToolTip="上方插入" Tag="{Binding}" Click="InsertAbove_Click" Style="{StaticResource SmallRowButton}"/>
         <Button Content="↓＋" ToolTip="下方插入" Tag="{Binding}" Click="InsertBelow_Click" Style="{StaticResource SmallRowButton}"/>
         <Button Content="×" ToolTip="删除此句" Tag="{Binding}" Click="DeleteStep_Click" Style="{StaticResource SmallRowButton}"/>
        </StackPanel>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="发送账号" Width="145" IsReadOnly="True"
       Binding="{Binding AccountLabel}" ElementStyle="{StaticResource TruncatedGridText}"/>
      <DataGridTemplateColumn Header="消息内容（选中后在下方编辑）" Width="*" MinWidth="170">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis"
         TextWrapping="NoWrap" ToolTip="{Binding Message}" Foreground="#EFF6FD"
         Margin="8,0" VerticalAlignment="Center"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="图片" Width="104">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <Button Content="{Binding AttachmentLabel}" Click="AttachmentQuickPreview_Click"
         Tag="{Binding}" Style="{StaticResource ImageRowButton}"
         Margin="3,0" Padding="5,2" ToolTip="{Binding AttachmentHint}">
         <Button.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
           <MenuItem Header="预览图片" Click="AttachmentPreview_Click"
            IsEnabled="{Binding HasAttachment}" CommandParameter="{Binding}"/>
           <MenuItem Header="添加 / 替换图片" Click="AttachmentReplace_Click" CommandParameter="{Binding}"/>
           <Separator/>
           <MenuItem Header="移除图片" Click="AttachmentRemove_Click"
            IsEnabled="{Binding HasAttachment}" CommandParameter="{Binding}"/>
          </ContextMenu>
         </Button.ContextMenu>
        </Button>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
   <Border Grid.Row="6" Background="#11283E" BorderBrush="#3E5C74"
    BorderThickness="1" CornerRadius="8" Padding="10">
    <Grid DataContext="{Binding SelectedItem,ElementName=StepsGrid}">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <TextBlock Text="选中消息：编辑发送账号、间隔、输入时长及提醒" FontWeight="SemiBold"
      Foreground="#D1E4F3"/>
     <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="3*"/>
       <ColumnDefinition Width="9"/>
       <ColumnDefinition Width="73"/>
       <ColumnDefinition Width="9"/>
       <ColumnDefinition Width="73"/>
       <ColumnDefinition Width="9"/>
       <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="发送账号" FontSize="11" Foreground="#AAC5DD"/>
       <ComboBox MinHeight="31" Margin="0,2,0,0"
        ItemsSource="{Binding AccountOptions,RelativeSource={RelativeSource AncestorType=UserControl}}"
        SelectedValue="{Binding Account,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        SelectedValuePath="Account" DisplayMemberPath="Label"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="间隔秒" FontSize="11" Foreground="#AAC5DD"/>
       <TextBox Text="{Binding DelayText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Margin="0,2,0,0" Padding="4"/>
      </StackPanel>
      <StackPanel Grid.Column="4">
       <TextBlock Text="输入秒" FontSize="11" Foreground="#AAC5DD"/>
       <TextBox Text="{Binding TypingText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Margin="0,2,0,0" Padding="4"/>
      </StackPanel>
      <StackPanel Grid.Column="6">
       <CheckBox Content="发送后提醒" IsChecked="{Binding PauseAfter,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        VerticalAlignment="Center" Foreground="#EAF5FD"/>
       <TextBox Text="{Binding ReminderText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        ToolTip="提醒文字" Margin="0,3,0,0" Padding="4"/>
      </StackPanel>
     </Grid>
     <TextBox Grid.Row="4" Text="{Binding Message,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled" FontSize="13" Padding="8,5"
      ToolTip="选择消息后在此编辑全文"/>
    </Grid>
   </Border>
   <TextBlock Grid.Row="8" x:Name="StatusText"
    Text="单击消息行即可选中；账号、间隔和提醒可单击编辑，图片可右键操作。"
    Foreground="#BBD0E3" TextWrapping="Wrap" FontSize="12"/>
  </Grid>
 </Grid>
</UserControl>