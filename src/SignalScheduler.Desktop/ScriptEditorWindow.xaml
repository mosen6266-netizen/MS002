<UserControl x:Class="SignalScheduler.Desktop.ScriptEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#0B1828" Foreground="#F0F6FD">
 <UserControl.Resources>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Background" Value="#1B3A52"/>
   <Setter Property="Foreground" Value="#F5F8FC"/>
   <Setter Property="BorderBrush" Value="#42647C"/>
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="MinHeight" Value="37"/>
   <Setter Property="Margin" Value="0,0,7,0"/>
  </Style>
  <Style x:Key="SmallRowButton" TargetType="Button"
   BasedOn="{StaticResource ActionButton}">
   <Setter Property="MinWidth" Value="31"/>
   <Setter Property="MinHeight" Value="35"/>
   <Setter Property="Padding" Value="2,2"/>
   <Setter Property="Margin" Value="0,0,3,0"/>
  </Style>
  <Style x:Key="ScriptListItem" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="8,9"/>
   <Setter Property="Margin" Value="0,1"/>
   <Setter Property="Foreground" Value="#F0F6FD"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="#276CA2"/>
     <Setter Property="Foreground" Value="#FFFFFF"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="BorderBrush" Value="#7DC9FF"/>
     <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Margin="18">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="235" MinWidth="180" MaxWidth="380"/>
   <ColumnDefinition Width="8"/>
   <ColumnDefinition Width="*" MinWidth="440"/>
  </Grid.ColumnDefinitions>
  <Border Background="#102438" BorderBrush="#31506B"
   BorderThickness="1" CornerRadius="10" Padding="12">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="剧本库" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="选择或新建剧本" Foreground="#AAC3D9" Margin="0,5,0,14"/>
     <TextBox x:Name="ScriptSearchBox" Margin="0,0,0,10" Height="36"
      ToolTip="输入剧本名称关键词；筛选不会清除正在编辑的内容"
      TextChanged="ScriptSearchBox_TextChanged"/>
     <TextBlock x:Name="ScriptSearchSummary" Text="输入名称可搜索剧本"
      Margin="0,0,0,10" Foreground="#A5BED6" FontSize="11"/>
     <Button Content="＋ 新建剧本" Click="NewScript_Click"
      Style="{StaticResource ActionButton}" Margin="0,0,0,8"/>
     <Button Content="刷新列表" Click="ReloadScripts_Click"
      Style="{StaticResource ActionButton}" Margin="0,0,0,12"/>
    </StackPanel>
    <ListBox x:Name="ScriptsList" Grid.Row="1" PreviewMouseRightButtonDown="ScriptsList_PreviewMouseRightButtonDown"
     SelectionChanged="ScriptsList_SelectionChanged"
     Background="#132B42" BorderBrush="#3C5B75"
     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
     ItemContainerStyle="{StaticResource ScriptListItem}">
     <ListBox.ContextMenu>
      <ContextMenu><MenuItem Header="重命名剧本" Click="RenameScript_Click"/></ContextMenu>
     </ListBox.ContextMenu>
     <ListBox.ItemTemplate>
      <DataTemplate>
       <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
        TextWrapping="NoWrap" ToolTip="{Binding Name}"
        Foreground="#F0F6FC" VerticalAlignment="Center"/>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
    <Expander Grid.Row="2" Margin="0,8,0,0" IsExpanded="False"
     Foreground="#EAF4FD" Background="#132B42">
     <Expander.Header>
      <TextBlock Text="更多操作 · 导入 / 导出 / 历史 / 图片"
       FontSize="12" Foreground="#D1E7F8" TextWrapping="Wrap"/>
     </Expander.Header>
     <StackPanel Margin="0,9,0,0">
      <Button Content="导入 JSON" Click="Import_Click"
       Style="{StaticResource ActionButton}" Margin="0,0,0,6"/>
      <Button Content="完整备份全部剧本＋图片 ZIP" Click="ExportBundle_Click"
       Style="{StaticResource ActionButton}" Margin="0,0,0,6"/>
      <Button Content="从 ZIP 批量恢复剧本和图片" Click="ImportBundle_Click"
       Style="{StaticResource ActionButton}" Margin="0,0,0,6"/>
      <Button Content="检查当前剧本图片" Click="CheckImages_Click"
       Style="{StaticResource ActionButton}" Margin="0,0,0,6"/>
      <Button Content="查看 / 恢复旧版本" Click="RestoreVersion_Click"
       Style="{StaticResource ActionButton}" Margin="0,0,0,6"/>
      <Button Content="导出当前剧本" Click="Export_Click"
       Style="{StaticResource ActionButton}" Margin="0,0,0,6"/>
      <TextBlock Text="数据保存于本地，升级不会覆盖。"
       FontSize="11" Foreground="#A5BED6" TextWrapping="Wrap"/>
     </StackPanel>
    </Expander>
   </Grid>
  </Border>
  <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
   Width="8" Background="#203D56" ResizeBehavior="PreviousAndNext"
   ShowsPreview="True" ToolTip="拖动调整剧本库和编辑区宽度"/>
  <Grid Grid.Column="2" Margin="12,0,0,0">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="8"/>
    <RowDefinition Height="0"/>
    <RowDefinition Height="8"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="12"/>
    <RowDefinition Height="140"/>
    <RowDefinition Height="10"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <StackPanel Grid.Row="0">
    <TextBlock Text="剧本工作台" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="选择消息后可在下方查看并编辑全文"
     FontSize="12" Foreground="#A8C1D8" Margin="0,4,0,7"/>
    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
     <Button Content="保存剧本" Style="{StaticResource ActionButton}"
      Click="Save_Click" Background="#127753" Margin="0,0,7,5"/>
     <Button Content="删除剧本" Style="{StaticResource ActionButton}"
      Click="DeleteScript_Click" Background="#783C45" BorderBrush="#A75D66"
      Margin="0,0,7,5"/>
     <Button Content="返回首页" Style="{StaticResource ActionButton}"
      Click="Close_Click" Margin="0,0,7,5"/>
    </WrapPanel>
   </StackPanel>
   <Border Grid.Row="2" Visibility="Collapsed" Background="#11273C" BorderBrush="#304D67"
    BorderThickness="1" CornerRadius="8" Padding="12">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="剧本名称" Foreground="#B9D0E4" Margin="0,0,0,5"/>
      <TextBox x:Name="NameBox" MaxLength="120" FontSize="14"
       TextChanged="EditorField_Changed"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="关联群组（可选）" Foreground="#B9D0E4" Margin="0,0,0,5"/>
      <TextBox x:Name="GroupBox" MaxLength="500"
       TextChanged="EditorField_Changed"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="4">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="10"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
     <TextBlock Text="消息列表" FontSize="17" FontWeight="SemiBold"
      Margin="0,0,0,6"/>
     <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
      <Button Content="＋ 加一句" Click="Append_Click" Style="{StaticResource ActionButton}"
       Margin="0,0,6,5"/>
      <Button Content="导入图片" Click="ImportImage_Click" Style="{StaticResource ActionButton}"
       Margin="0,0,6,5"/>
      <Button Content="预览图片" Click="PreviewImage_Click" Style="{StaticResource ActionButton}"
       Margin="0,0,6,5"/>
      <Button Content="向上移动" Click="MoveUp_Click" Style="{StaticResource ActionButton}"
       Margin="0,0,6,5"/>
      <Button Content="向下移动" Click="MoveDown_Click" Style="{StaticResource ActionButton}"
       Margin="0,0,6,5"/>
     </WrapPanel>
    </StackPanel>
    <DataGrid x:Name="StepsGrid" Grid.Row="2" MinHeight="120"
     HeadersVisibility="Column" EnableColumnVirtualization="False"
     MinColumnWidth="46" VerticalScrollBarVisibility="Auto"
     AutoGenerateColumns="False" CanUserAddRows="False"
     IsReadOnly="False" RowHeight="48" ColumnHeaderHeight="42"
     ColumnHeaderStyle="{StaticResource DarkGridHeader}"
     AlternationCount="2" RowHeaderWidth="0" SelectionMode="Single"
     SelectionUnit="FullRow" CellEditEnding="StepsGrid_CellEditEnding" PreviewMouseLeftButtonUp="StepsGrid_PreviewMouseLeftButtonUp"
     BorderBrush="#3B5871" Background="#112438" Foreground="#EFF6FD"
     RowBackground="#132D44" AlternatingRowBackground="#1A354C"
     ScrollViewer.HorizontalScrollBarVisibility="Auto"
     EnableRowVirtualization="True">
     <DataGrid.RowStyle>
      <Style TargetType="DataGridRow">
       <Setter Property="Background" Value="#132D44"/>
       <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
         <Setter Property="Background" Value="#256AA1"/>
         <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
       </Style.Triggers>
      </Style>
     </DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTextColumn Header="序号" Width="49"
       Binding="{Binding PositionLabel}" IsReadOnly="True"
       ElementStyle="{StaticResource TruncatedGridText}"/>
      <DataGridTemplateColumn Header="插入 / 删除" Width="126">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="↑＋" ToolTip="上方插入" Tag="{Binding}"
           Click="InsertAbove_Click" Style="{StaticResource SmallRowButton}"/>
          <Button Content="↓＋" ToolTip="下方插入" Tag="{Binding}"
           Click="InsertBelow_Click" Style="{StaticResource SmallRowButton}"/>
          <Button Content="×" ToolTip="删除此句" Tag="{Binding}"
           Click="DeleteStep_Click" Style="{StaticResource SmallRowButton}"/>
         </StackPanel>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="发送账号备注" Width="175">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <TextBlock Text="{Binding AccountLabel}" Foreground="#E6F2FE"
          TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
          VerticalAlignment="Center" Margin="8,0"
          ToolTip="{Binding AccountLabel}"/>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
       <DataGridTemplateColumn.CellEditingTemplate>
        <DataTemplate>
         <ComboBox
          ItemsSource="{Binding AccountOptions,RelativeSource={RelativeSource AncestorType=UserControl}}"
          SelectedValue="{Binding Account,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          SelectedValuePath="Account" DisplayMemberPath="Label"
          Background="#17354C" Foreground="White" MinHeight="36"/>
        </DataTemplate>
       </DataGridTemplateColumn.CellEditingTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="消息内容（下方可编辑全文）" Width="350" MinWidth="280">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis"
          TextWrapping="NoWrap" VerticalAlignment="Center" Margin="8,0"
          ToolTip="{Binding Message}" Foreground="#F0F6FD"/>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
       <DataGridTemplateColumn.CellEditingTemplate>
        <DataTemplate>
         <TextBox Text="{Binding Message,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          AcceptsReturn="False" TextWrapping="NoWrap"
          HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Center"/>
        </DataTemplate>
       </DataGridTemplateColumn.CellEditingTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="间隔(秒)" Width="86"
       Binding="{Binding DelayText,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"
       ElementStyle="{StaticResource TruncatedGridText}"/>
      <DataGridTextColumn Header="输入(秒)" Width="86"
       Binding="{Binding TypingText,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"
       ElementStyle="{StaticResource TruncatedGridText}"/>
      <DataGridTemplateColumn Header="提醒" Width="62">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <CheckBox IsChecked="{Binding PauseAfter,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          Style="{StaticResource LargeRowCheckBox}"
          ToolTip="此句发送后暂停并提醒"/>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="提醒内容" Width="145">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <TextBlock Text="{Binding ReminderText}" TextTrimming="CharacterEllipsis"
          TextWrapping="NoWrap" Foreground="#EEF5FD"
          ToolTip="{Binding ReminderText}" VerticalAlignment="Center" Margin="8,0"/>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
       <DataGridTemplateColumn.CellEditingTemplate>
        <DataTemplate>
         <TextBox Text="{Binding ReminderText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
        </DataTemplate>
       </DataGridTemplateColumn.CellEditingTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="附件" Width="108">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <Button Content="{Binding AttachmentLabel}" Click="AttachmentQuickPreview_Click"
          Tag="{Binding}" Style="{StaticResource SmallRowButton}" MinWidth="85"
          Margin="4,0" Padding="7,2" Background="#20445C" Foreground="#D6EDFF"
          ToolTip="{Binding AttachmentHint}">
          <Button.ContextMenu>
           <ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
            <MenuItem Header="预览图片" Click="AttachmentPreview_Click"
             IsEnabled="{Binding HasAttachment}" CommandParameter="{Binding}"/>
            <MenuItem Header="添加 / 替换图片" Click="AttachmentReplace_Click"
             CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="移除图片" Click="AttachmentRemove_Click"
             IsEnabled="{Binding HasAttachment}" CommandParameter="{Binding}"/>
           </ContextMenu>
          </Button.ContextMenu>
         </Button>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
   <Border Grid.Row="6" Background="#11283E" BorderBrush="#3E5C74"
    BorderThickness="1" CornerRadius="8" Padding="12">
    <Grid DataContext="{Binding SelectedItem,ElementName=StepsGrid}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="0,0,0,7">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="所选消息 · 完整内容" FontWeight="SemiBold"
        Foreground="#D1E4F3"/>
       <TextBlock Text="{Binding PositionLabel,StringFormat=第{0}句}"
        Foreground="#7DD4FF" Margin="10,0,0,0" FontWeight="SemiBold"/>
      </StackPanel>
      <TextBlock DockPanel.Dock="Right" Text="可滚动阅读或直接编辑，列表行高保持不变"
       Foreground="#8FA9C2" FontSize="11"/>
     </DockPanel>
     <TextBox Grid.Row="1" Text="{Binding Message,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Auto" MinHeight="74" FontSize="13"
      ToolTip="点击消息行选中，长文本在这里完整查看和编辑"/>
    </Grid>
   </Border>
   <TextBlock Grid.Row="8" x:Name="StatusText"
    Text="单击消息行即可选中；账号、间隔和提醒可单击编辑，图片可右键操作。"
    Foreground="#BBD0E3" TextWrapping="Wrap" FontSize="12"/>
  </Grid>
 </Grid>
</UserControl>