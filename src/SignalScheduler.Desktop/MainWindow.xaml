<Window x:Class="SignalScheduler.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Signal Auto Scheduler V8" Height="820" Width="1280" MinHeight="700" MinWidth="1080"
 WindowStartupLocation="CenterScreen"
 Background="#07111F" Foreground="#EAF2FF">
 <Window.Resources>
  <SolidColorBrush x:Key="PanelBrush" Color="#0D1A2B"/>
  <SolidColorBrush x:Key="PanelBorder" Color="#233751"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="Background" Value="#15263B"/>
   <Setter Property="BorderBrush" Value="#2B4463"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="#091625"/>
   <Setter Property="Foreground" Value="#DCE8F7"/>
   <Setter Property="BorderBrush" Value="#263A55"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="210"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <Border Background="#091523" BorderBrush="#1D3049" BorderThickness="0,0,1,0">
   <Grid Margin="18">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="26"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="Signal 调度台" FontSize="23" FontWeight="Bold"/>
     <TextBlock Text="V8.0.0-alpha.2" Margin="0,6,0,0" Foreground="#8FA7C2"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <Button Content="⌂  首页" HorizontalContentAlignment="Left" Background="#203A61"/>
     <Button Content="◉  账号" HorizontalContentAlignment="Left" Margin="0,10,0,0"/>
     <Button Content="✎  剧本" HorizontalContentAlignment="Left" Margin="0,10,0,0"/>
     <Button Content="▦  群组" HorizontalContentAlignment="Left" Margin="0,10,0,0"/>
     <Button Content="▶  运行任务" HorizontalContentAlignment="Left" Margin="0,10,0,0"/>
     <Button Content="◷  历史记录" HorizontalContentAlignment="Left" Margin="0,10,0,0"/>
     <Button Content="⚙  设置" HorizontalContentAlignment="Left" Margin="0,10,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="3">
     <TextBlock x:Name="EngineBadge" Text="● 后台连接中" Foreground="#F5C451"/>
     <TextBlock x:Name="MigrationBadge" Text="正在读取本地数据" Margin="0,6,0,0" Foreground="#8FA7C2" FontSize="12"/>
    </StackPanel>
   </Grid>
  </Border>

  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
   <Grid Margin="28">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="18"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="18"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="18"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="首页" FontSize="30" FontWeight="Bold"/>
      <TextBlock Text="原生 Windows V8 调度核心" Margin="0,5,0,0" Foreground="#8FA7C2"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="刷新状态" Click="RefreshButton_Click"/>
      <Button Content="+ 扫码登录" IsEnabled="False" Background="#138A4B"/>
     </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions>
      <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
     </Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" Padding="18">
      <StackPanel><TextBlock Text="后台引擎" Foreground="#8FA7C2"/><TextBlock x:Name="EngineStatusText" Text="连接中" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
     </Border>
     <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" Padding="18">
      <StackPanel><TextBlock Text="账号" Foreground="#8FA7C2"/><TextBlock x:Name="AccountsCountText" Text="0" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
     </Border>
     <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" Padding="18">
      <StackPanel><TextBlock Text="群组" Foreground="#8FA7C2"/><TextBlock x:Name="GroupsCountText" Text="0" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
     </Border>
     <Border Grid.Column="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
      <StackPanel><TextBlock Text="剧本" Foreground="#8FA7C2"/><TextBlock x:Name="ScriptsCountText" Text="0" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
     </Border>
    </Grid>

    <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,14,0">
       <TextBlock Text="账号" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
       <ListBox x:Name="AccountsList" Height="180"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,14,0">
       <TextBlock Text="群组" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
       <ListBox x:Name="GroupsList" Height="180"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="剧本" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
       <ListBox x:Name="ScriptsList" Height="180"/>
      </StackPanel>
     </Grid>
    </Border>

    <Grid Grid.Row="6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,12,0">
      <StackPanel>
       <TextBlock Text="任务恢复状态" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock x:Name="JobsSummaryText" Text="暂无任务" Margin="0,7,0,12" Foreground="#8FA7C2"/>
       <ListBox x:Name="JobsList" Height="175"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
      <StackPanel>
       <TextBlock Text="当前阶段" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock Text="V8 已经切换为原生 WPF + 独立后台 Engine，不依赖浏览器或 WebView2。" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#B9C9DB"/>
       <TextBlock Text="Signal 实际发送仍保持关闭，等 Guardian、登录数据和发送链迁移完成后再开启。" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#F5C451"/>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </ScrollViewer>
 </Grid>
</Window>
