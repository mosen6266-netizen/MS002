<Window x:Class="SignalScheduler.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Signal 调度台" Icon="pack://application:,,,/signal-brand.png" Width="1500" Height="950" MinWidth="1050" MinHeight="700"
 WindowStartupLocation="CenterScreen" Closing="MainWindow_Closing"
 WindowStyle="None" ResizeMode="CanResize"
 Background="#091523" Foreground="#EAF2FF">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="7"
   GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="PanelBackground" Color="#10243A"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#19364F"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#365571"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers>
    <Trigger Property="IsKeyboardFocusWithin" Value="True">
     <Setter Property="BorderBrush" Value="#7DC9FF"/>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Opacity" Value="0.62"/>
     <Setter Property="Cursor" Value="Arrow"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Margin" Value="0,0,0,7"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Padding" Value="16,13"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <!-- Avoid Windows' light-blue native Button hover which makes the
        white navigation text unreadable on dark application surfaces. -->
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="NavSurface" Background="{TemplateBinding Background}"
       CornerRadius="5" BorderThickness="0"
       Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="NavSurface" Property="Background" Value="#245579"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="NavSurface" Property="Background" Value="#174466"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="NavSurface" Property="BorderBrush" Value="#7DC9FF"/>
        <Setter TargetName="NavSurface" Property="BorderThickness" Value="1"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="44"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <Grid.ColumnDefinitions>
   <ColumnDefinition x:Name="NavigationColumn" Width="215"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#101D30"
   BorderBrush="#2C4864" BorderThickness="0,0,0,1">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="46"/><ColumnDefinition Width="46"/>
     <ColumnDefinition Width="50"/>
    </Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
     <Image Source="pack://application:,,,/signal-brand.png"
      Width="22" Height="22" Margin="0,0,11,0"/>
     <TextBlock Text="Signal 调度台" Foreground="#EAF4FD"
      FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <TextBlock Text="  /  MS002" Foreground="#7196B4"
      FontSize="12" VerticalAlignment="Center"/>
    </StackPanel>
    <Button Grid.Column="1" Content="─" ToolTip="最小化" Click="Minimize_Click"
     shell:WindowChrome.IsHitTestVisibleInChrome="True"
     Background="Transparent" Foreground="#E8F2FC" FontSize="18"
     BorderThickness="0" Padding="0"/>
    <Button Grid.Column="2" x:Name="MaximizeButton" Content="□"
     ToolTip="最大化 / 还原" Click="Maximize_Click"
     shell:WindowChrome.IsHitTestVisibleInChrome="True"
     Background="Transparent" Foreground="#E8F2FC" FontSize="18"
     BorderThickness="0" Padding="0"/>
    <Button Grid.Column="3" Content="×" ToolTip="关闭程序"
     Click="WindowClose_Click"
     shell:WindowChrome.IsHitTestVisibleInChrome="True"
     Background="#243149" Foreground="#F3F8FD" FontSize="20"
     BorderThickness="0" Padding="0"/>
   </Grid>
  </Border>

  <Border Grid.Row="1" Grid.Column="0" Background="#081523"
   BorderBrush="#20354F" BorderThickness="0,0,1,0">
   <Grid Margin="16,22">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="22"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="Signal 调度台" FontSize="22" FontWeight="Bold"/>
     <TextBlock Text="V8.0.0-beta.12" Foreground="#8EACC8" Margin="0,7,0,0"/>
     <TextBlock Text="桌面消息管理" Foreground="#7390AC" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <Button x:Name="HomeNav" Content="⌂   首页 · 快速开始" Tag="home"
       Style="{StaticResource NavButton}" Click="Nav_Click"/>
     <Button x:Name="AccountNav" Content="◉   账号与群组" Tag="accounts"
       Style="{StaticResource NavButton}" Click="Nav_Click"/>
     <Button x:Name="ScriptNav" Content="✎   剧本管理" Tag="scripts"
       Style="{StaticResource NavButton}" Click="Nav_Click"/>
     <Button x:Name="TaskNav" Tag="tasks"
       Style="{StaticResource NavButton}" Click="Nav_Click"
       ToolTip="查看所有群组任务，角标只统计正在运行的群任务">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock x:Name="TaskNavLabel" Text="◷   当前运行任务"
        Foreground="#F1F7FF" VerticalAlignment="Center"/>
       <Border x:Name="TaskNavBadge" Background="#187A62"
        CornerRadius="12" MinWidth="27" MinHeight="23"
        Padding="6,2" Margin="8,0,0,0"
        VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="TaskNavBadgeCount" Text="0"
         Foreground="White" FontWeight="Bold" FontSize="12"
         HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
      </StackPanel>
     </Button>
     <Button x:Name="RecoveryNav" Content="⚠   异常恢复" Tag="recovery"
       Style="{StaticResource NavButton}" Click="Nav_Click"/>
     <Button x:Name="HistoryNav" Content="◷   历史记录" Tag="history"
       Style="{StaticResource NavButton}" Click="Nav_Click"/>
     <Button x:Name="LicenseNav" Content="⚙   授权设置" Tag="license"
       Style="{StaticResource NavButton}" Click="Nav_Click"/>
     <Button x:Name="UpdateNav" Content="↻   检查更新" Tag="update"
       Style="{StaticResource NavButton}" Click="Nav_Click"/>
    </StackPanel>
    <Border Grid.Row="4" Background="#10273C" CornerRadius="8" Padding="12">
     <StackPanel>
      <TextBlock x:Name="EngineBadge" Text="● 后台连接中"
       Foreground="#E8C16A" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="SignalStatusText" Text="Signal 检查中…"
       Foreground="#A5C3DD" Margin="0,7,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="AccountsCountText" Text="账号检查中"
       Margin="0,7,0,0" Foreground="#A5C3DD" TextWrapping="Wrap"/>
      <TextBlock x:Name="MigrationBadge" Text="读取本地数据中"
       Margin="0,9,0,0" Foreground="#8EAAC5" FontSize="11" TextWrapping="Wrap"/>
      <Button x:Name="ExportDiagnosticButton" Content="导出脱敏诊断报告"
       Click="ExportDiagnostic_Click" Margin="0,13,0,0"
       Padding="10,8" Background="#244560"
       ToolTip="只导出连接状态、数量、时间等安全统计；不含手机号、群名、消息正文、密钥或原始日志"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>

  <Grid Grid.Row="1" Grid.Column="1" Background="#0A1828">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Border Background="#0D2135" BorderBrush="#263F56"
    BorderThickness="0,0,0,1" Padding="22,15">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock x:Name="PageTitle" Text="首页 · 直接开始" FontSize="23"
        FontWeight="Bold"/>
      <TextBlock x:Name="PageSubtitle"
       Text="选择剧本、勾选群组，确认后直接启动。每个群的状态单独保存。"
       FontSize="12" Foreground="#AAC4DC" Margin="0,5,0,0"
       TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal"
       VerticalAlignment="Center">
      <Button x:Name="ScanButton" Content="+ 扫码登录"
       Background="#0F7954" IsEnabled="False"
       Click="LinkAccount_Click" Margin="0,0,9,0"/>
      <Button Content="刷新" Click="RefreshButton_Click" Padding="16,10"/>
     </StackPanel>
    </Grid>
   </Border>

   <Border x:Name="AlertStrip" Grid.Row="1" Visibility="Collapsed"
     Background="#403123" BorderBrush="#986638" BorderThickness="0,0,0,1"
     Padding="18,8">
    <DockPanel>
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
      <TextBlock Text="● " Foreground="#FFCC83"/>
      <TextBlock x:Name="AlertSummaryText" Text="有未查看的任务提醒"
       Foreground="#FFE2B8" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
      Content="查看 / 收起提醒" Background="#59432C" Padding="10,4"
      Click="ToggleAlerts_Click"/>
    </DockPanel>
   </Border>

   <Grid Grid.Row="2">
    <ScrollViewer x:Name="WorkspaceScroll"
      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
      CanContentScroll="False" Background="#091827" PanningMode="VerticalOnly"
      Focusable="False">
     <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch"
      VerticalContentAlignment="Stretch"/>
    </ScrollViewer>
    <Border x:Name="AlertPanel" Visibility="Collapsed" Panel.ZIndex="6"
      Background="#10273C" BorderBrush="#B17D48" BorderThickness="1"
      CornerRadius="8" Width="470" MaxWidth="470"
      HorizontalAlignment="Right" VerticalAlignment="Top"
      Margin="12" Padding="16">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="12"/>
       <RowDefinition Height="*" MaxHeight="385"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel>
       <TextBlock Text="通知与异常" FontSize="17" FontWeight="SemiBold"/>
       <Button DockPanel.Dock="Right" Content="关闭"
        Click="ToggleAlerts_Click" Padding="8,3"/>
      </DockPanel>
      <ListBox x:Name="NotificationsList" Grid.Row="2"
       Background="#10273C" Foreground="#EFD8BD"
       BorderThickness="0" FontSize="12"/>
      <Button Grid.Row="3" Content="清空当前提示" Click="ClearAlerts_Click"
       Margin="0,12,0,0" Padding="10,7"/>
     </Grid>
    </Border>
   </Grid>

   <Border Grid.Row="3" BorderBrush="#223B53" BorderThickness="0,1,0,0"
    Background="#0D2135" Padding="18,8">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="BottomStatusText"
      Text="准备就绪" FontSize="12" Foreground="#AFC7DF"
      TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="RuntimeVersionText" Grid.Column="1"
      Text="Signal 运行环境检查中" FontSize="11" Foreground="#809EBB"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>