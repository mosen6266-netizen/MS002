<Application x:Class="SignalScheduler.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/Monochrome.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="Surface" Color="#191B1E"/>
  <SolidColorBrush x:Key="SurfaceAlt" Color="#191B1E"/>
  <SolidColorBrush x:Key="BorderColor" Color="#41454B"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#F1F2F4"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#D0D2D7"/>
  <!-- Consistent high-contrast dark button visuals on Windows 10/11.
       Native theme templates can turn disabled labels into unreadable gray.
       The disabled template explicitly controls the face and the text,
       without fading the entire button or removing the visible label. -->
  <Style TargetType="{x:Type Window}">
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
   <Setter Property="UseLayoutRounding" Value="True"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style TargetType="{x:Type UserControl}">
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>
  <Style x:Key="ReadableButtonBase" TargetType="{x:Type Button}">
   <Setter Property="Background" Value="#2D3035"/>
   <Setter Property="Foreground" Value="#F7FAFE"/>
   <Setter Property="BorderBrush" Value="#777D85"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="MinHeight" Value="36"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type Button}">
      <Border x:Name="ReadableButtonFace"
       Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}"
       CornerRadius="8" Padding="{TemplateBinding Padding}"
       SnapsToDevicePixels="True">
       <ContentPresenter x:Name="ReadableButtonLabel"
        Content="{TemplateBinding Content}"
        ContentTemplate="{TemplateBinding ContentTemplate}"
        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
        TextElement.Foreground="{TemplateBinding Foreground}"
        RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ReadableButtonFace" Property="BorderBrush" Value="#D0D2D7"/>
        <Setter TargetName="ReadableButtonFace" Property="BorderThickness" Value="2"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ReadableButtonFace" Property="BorderBrush" Value="#D0D2D7"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="ReadableButtonFace" Property="BorderBrush" Value="#F1F2F4"/>
        <Setter TargetName="ReadableButtonFace" Property="Opacity" Value="0.86"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ReadableButtonFace" Property="Background" Value="#333C47"/>
        <Setter TargetName="ReadableButtonFace" Property="BorderBrush" Value="#555A61"/>
        <Setter TargetName="ReadableButtonFace" Property="Opacity" Value="1"/>
        <Setter TargetName="ReadableButtonLabel" Property="TextElement.Foreground" Value="#F6F8FC"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Cursor" Value="Arrow"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ReadableButtonBase}"/>
  <Style x:Key="DarkGridHeader" TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#222529"/>
   <Setter Property="Foreground" Value="#F5F8FC"/>
   <Setter Property="BorderBrush" Value="#41454B"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Padding" Value="10,10"/>
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>
  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkGridHeader}"/>
  <Style x:Key="TruncatedGridText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#F1F2F4"/>
   <Setter Property="TextWrapping" Value="NoWrap"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="8,0"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#F1F2F4"/>
   <Setter Property="BorderBrush" Value="#2D3035"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Padding" Value="2,0"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGridRow">
   <!-- Do not force every row to 48 px: ten paged groups must fit on
        smaller screens, while other grids set their own row height. -->
   <Setter Property="MinHeight" Value="22"/>
   <Setter Property="Background" Value="#191B1E"/>
   <Setter Property="Foreground" Value="#F1F2F4"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="#2D3035"/>
    </Trigger>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="#41454B"/>
     <Setter Property="Foreground" Value="#FFFFFF"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#191B1E"/>
   <Setter Property="Foreground" Value="#F1F2F4"/>
   <Setter Property="RowBackground" Value="#191B1E"/>
   <Setter Property="AlternatingRowBackground" Value="#222529"/>
   <Setter Property="BorderBrush" Value="#41454B"/>
   <Setter Property="ColumnHeaderStyle" Value="{StaticResource DarkGridHeader}"/>
   <Setter Property="RowHeight" Value="42"/>
   <Setter Property="ColumnHeaderHeight" Value="42"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="EnableRowVirtualization" Value="True"/>
   <!-- Column virtualization plus star-sized columns in vertically scrolling
        WPF content can yield a zero-width viewport on some Windows systems.
        Never virtualize desktop table columns. Row virtualization stays on. -->
   <Setter Property="EnableColumnVirtualization" Value="False"/>
   <Setter Property="MinColumnWidth" Value="46"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
  </Style>
  <!-- Custom non-editable combo popup: system native template displayed white
       text on a white face on some Windows themes. Match popup and collapsed
       selection surfaces explicitly so contrast remains predictable. -->
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#222529"/>
   <Setter Property="Foreground" Value="#F4F8FD"/>
   <Setter Property="BorderBrush" Value="#555A61"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="MinHeight" Value="39"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid MinWidth="90">
       <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
        CornerRadius="8"/>
       <ToggleButton x:Name="Toggle"
        Focusable="False"
        IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"
        Background="Transparent" BorderThickness="0"
        HorizontalContentAlignment="Stretch">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
           <ContentPresenter HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>
          </Border>
         </ControlTemplate>
        </ToggleButton.Template>
        <Grid Background="Transparent">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="37"/>
         </Grid.ColumnDefinitions>
         <ContentPresenter Margin="10,5,4,5"
          Content="{TemplateBinding SelectionBoxItem}"
          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
          IsHitTestVisible="False" VerticalAlignment="Center"
          TextElement.Foreground="#F3F7FC"
          RecognizesAccessKey="True"/>
         <Path Grid.Column="1" Data="M 0 0 L 5 5 L 10 0" Stroke="#F1F2F4"
          StrokeThickness="2" HorizontalAlignment="Center"
          VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
       </ToggleButton>
       <Popup x:Name="PART_Popup" AllowsTransparency="True"
        Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
        Focusable="False" PopupAnimation="Fade">
        <Border x:Name="DropDownBorder" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"
         MaxHeight="350" Background="#222529"
         BorderBrush="#555A61" BorderThickness="1" CornerRadius="6">
         <ScrollViewer Margin="3" CanContentScroll="True"
          VerticalScrollBarVisibility="Auto">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
         </ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ComboBorder" Property="Opacity" Value="0.5"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#A9ADB4"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F4F8FD"/>
   <Setter Property="Background" Value="#222529"/>
   <Setter Property="Padding" Value="10,8"/>
   <Setter Property="MinHeight" Value="36"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="MenuRow" Background="{TemplateBinding Background}"
       Padding="{TemplateBinding Padding}" CornerRadius="3">
       <ContentPresenter HorizontalAlignment="Stretch"
        VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="MenuRow" Property="Background" Value="#41454B"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
       </Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="MenuRow" Property="Background" Value="#41454B"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#F1F2F4"/>
   <Setter Property="Background" Value="#222529"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="19,11"/>
   <Setter Property="Margin" Value="0,0,7,0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="TabSurface" Background="{TemplateBinding Background}"
       CornerRadius="8,8,0,0" BorderBrush="#41454B"
       BorderThickness="1,1,1,0"
       Padding="{TemplateBinding Padding}">
       <ContentPresenter ContentSource="Header"
        HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="TabSurface" Property="Background" Value="#2D3035"/>
       </Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="TabSurface" Property="Background" Value="#41454B"/>
        <Setter TargetName="TabSurface" Property="BorderBrush" Value="#A9ADB4"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="#F1F2F4"/>
   <Setter Property="Background" Value="#191B1E"/>
   <Setter Property="Padding" Value="11,10"/>
   <Setter Property="MinHeight" Value="46"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Highlight" Background="{TemplateBinding Background}"
       BorderThickness="3,0,0,0" BorderBrush="Transparent"
       Padding="{TemplateBinding Padding}" MinHeight="46">
       <ContentPresenter VerticalAlignment="Center"
        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Highlight" Property="Background" Value="#2D3035"/>
       </Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Highlight" Property="Background" Value="#41454B"/>
        <Setter TargetName="Highlight" Property="BorderBrush" Value="#A9ADB4"/>
        <Setter Property="Foreground" Value="White"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#222529"/>
   <Setter Property="Foreground" Value="#F1F2F4"/>
   <Setter Property="BorderBrush" Value="#41454B"/>
   <Setter Property="CaretBrush" Value="#FFFFFF"/>
   <Setter Property="SelectionBrush" Value="#555A61"/>
   <Setter Property="Padding" Value="7,6"/>
   <Style.Triggers>
    <!-- Change color only: changing border width causes the reported editor jitter. -->
    <Trigger Property="IsKeyboardFocusWithin" Value="True">
     <Setter Property="BorderBrush" Value="#D0D2D7"/>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Background" Value="#292C31"/>
     <Setter Property="Foreground" Value="#BFC2C7"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <!-- Modern WPF controls share one compact, neutral visual language.
       Keep the traditional PART_ContentHost to preserve native selection,
       IME composition, multiline editing and keyboard shortcuts. -->
  <Style x:Key="Ui2RoundedTextBox" TargetType="TextBox">
   <Setter Property="Background" Value="{StaticResource Ui2SurfaceRaised}"/>
   <Setter Property="Foreground" Value="{StaticResource Ui2Text}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Ui2BorderStrong}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CaretBrush" Value="{StaticResource Ui2Text}"/>
   <Setter Property="SelectionBrush" Value="{StaticResource Ui2Selected}"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border x:Name="InputSurface"
       Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}"
       Padding="{TemplateBinding Padding}" CornerRadius="7">
       <ScrollViewer x:Name="PART_ContentHost"
        Focusable="False" SnapsToDevicePixels="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource Ui2Focus}"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="InputSurface" Property="Background" Value="{StaticResource Ui2DisabledBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Ui2TextSecondary}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource Ui2RoundedTextBox}"/>
  <Style TargetType="PasswordBox">
   <Setter Property="Background" Value="{StaticResource Ui2SurfaceRaised}"/>
   <Setter Property="Foreground" Value="{StaticResource Ui2Text}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Ui2BorderStrong}"/>
   <Setter Property="CaretBrush" Value="{StaticResource Ui2Text}"/>
   <Setter Property="Padding" Value="10,7"/>
  </Style>
  <Style TargetType="ProgressBar">
   <Setter Property="Background" Value="{StaticResource Ui2SurfaceHover}"/>
   <Setter Property="Foreground" Value="{StaticResource Ui2TextSecondary}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Ui2Border}"/>
   <Setter Property="Height" Value="7"/>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Background" Value="{StaticResource Ui2SurfaceRaised}"/>
   <Setter Property="Foreground" Value="{StaticResource Ui2Text}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Ui2BorderStrong}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,7"/>
   <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="GroupBox">
   <Setter Property="Background" Value="{StaticResource Ui2Surface}"/>
   <Setter Property="Foreground" Value="{StaticResource Ui2Text}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Ui2Border}"/>
   <Setter Property="Padding" Value="12"/>
  </Style>
  <Style x:Key="LargeRowCheckBox" TargetType="CheckBox">
   <Setter Property="Width" Value="56"/>
   <Setter Property="Height" Value="46"/>
   <Setter Property="HorizontalAlignment" Value="Center"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <Grid Width="56" Height="46" Background="Transparent">
       <Border x:Name="CheckFrame" Width="29" Height="29" CornerRadius="5"
        Background="#191B1E" BorderBrush="#A9ADB4" BorderThickness="2"
        HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="CheckMark" Text="✓" FontSize="23"
         FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
         Foreground="White" Visibility="Collapsed"/>
       </Border>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="CheckFrame" Property="Background" Value="#128464"/>
        <Setter TargetName="CheckFrame" Property="BorderBrush" Value="#35C79A"/>
        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="CheckFrame" Property="BorderBrush" Value="#D0D2D7"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="CheckFrame" Property="Opacity" Value="0.4"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="MinHeight" Value="35"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Foreground" Value="#F1F2F4"/>
  </Style>
   </ResourceDictionary>
 </Application.Resources>
</Application>