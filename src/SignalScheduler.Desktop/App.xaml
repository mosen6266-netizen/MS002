<Application x:Class="SignalScheduler.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Surface" Color="#101E30"/>
  <SolidColorBrush x:Key="SurfaceAlt" Color="#192C42"/>
  <SolidColorBrush x:Key="BorderColor" Color="#35536D"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#F1F6FD"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#BACDE0"/>
  <Style x:Key="DarkGridHeader" TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#213C56"/>
   <Setter Property="Foreground" Value="#F5F8FC"/>
   <Setter Property="BorderBrush" Value="#48637D"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Padding" Value="10,10"/>
   <Setter Property="MinHeight" Value="42"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>
  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkGridHeader}"/>
  <Style x:Key="TruncatedGridText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#EFF5FD"/>
   <Setter Property="TextWrapping" Value="NoWrap"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="8,0"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#EEF5FC"/>
   <Setter Property="BorderBrush" Value="#314C64"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Padding" Value="2,0"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGridRow">
   <Setter Property="Height" Value="48"/>
   <Setter Property="MinHeight" Value="48"/>
   <Setter Property="MaxHeight" Value="48"/>
   <Setter Property="Background" Value="#14283E"/>
   <Setter Property="Foreground" Value="#EEF5FD"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="#244F70"/>
     <Setter Property="Foreground" Value="White"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="#1C3D59"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#101E30"/>
   <Setter Property="Foreground" Value="#EFF5FD"/>
   <Setter Property="RowBackground" Value="#12283E"/>
   <Setter Property="AlternatingRowBackground" Value="#192F45"/>
   <Setter Property="BorderBrush" Value="#365671"/>
   <Setter Property="ColumnHeaderStyle" Value="{StaticResource DarkGridHeader}"/>
   <Setter Property="RowHeight" Value="48"/>
   <Setter Property="ColumnHeaderHeight" Value="42"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="EnableRowVirtualization" Value="True"/>
   <Setter Property="EnableColumnVirtualization" Value="True"/>
  </Style>
  <!-- Custom non-editable combo popup: system native template displayed white
       text on a white face on some Windows themes. Match popup and collapsed
       selection surfaces explicitly so contrast remains predictable. -->
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#17344C"/>
   <Setter Property="Foreground" Value="#F4F8FD"/>
   <Setter Property="BorderBrush" Value="#4C7191"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="MinHeight" Value="39"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid MinWidth="90">
       <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
        CornerRadius="6"/>
       <ToggleButton x:Name="Toggle"
        Focusable="False"
        IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"
        Background="Transparent" BorderThickness="0"
        HorizontalContentAlignment="Stretch">
        <Grid Background="Transparent">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="37"/>
         </Grid.ColumnDefinitions>
         <ContentPresenter Margin="10,5,4,5"
          Content="{TemplateBinding SelectionBoxItem}"
          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
          IsHitTestVisible="False" VerticalAlignment="Center"
          TextElement.Foreground="#F3F7FC"
          RecognizesAccessKey="True"/>
         <Path Grid.Column="1" Data="M 0 0 L 5 5 L 10 0" Stroke="#E6F0FC"
          StrokeThickness="2" HorizontalAlignment="Center"
          VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
       </ToggleButton>
       <Popup x:Name="PART_Popup" AllowsTransparency="True"
        Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
        Focusable="False" PopupAnimation="Fade">
        <Border x:Name="DropDownBorder" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"
         MaxHeight="350" Background="#172E43"
         BorderBrush="#53738B" BorderThickness="1" CornerRadius="6">
         <ScrollViewer Margin="3" CanContentScroll="True"
          VerticalScrollBarVisibility="Auto">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
         </ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ComboBorder" Property="Opacity" Value="0.5"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#6AAEEA"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F4F8FD"/>
   <Setter Property="Padding" Value="10,7"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="#F0F6FD"/>
   <Setter Property="Background" Value="#132B40"/>
   <Setter Property="Padding" Value="11,10"/>
   <Setter Property="MinHeight" Value="46"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Highlight" Background="{TemplateBinding Background}"
       BorderThickness="3,0,0,0" BorderBrush="Transparent"
       Padding="{TemplateBinding Padding}" MinHeight="46">
       <ContentPresenter VerticalAlignment="Center"
        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Highlight" Property="Background" Value="#294A66"/>
       </Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Highlight" Property="Background" Value="#285C8E"/>
        <Setter TargetName="Highlight" Property="BorderBrush" Value="#66C3FF"/>
        <Setter Property="Foreground" Value="White"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#142C42"/>
   <Setter Property="Foreground" Value="#EEF5FC"/>
   <Setter Property="BorderBrush" Value="#486782"/>
   <Setter Property="CaretBrush" Value="#FFFFFF"/>
   <Setter Property="Padding" Value="7,6"/>
  </Style>
  <Style x:Key="LargeRowCheckBox" TargetType="CheckBox">
   <Setter Property="Width" Value="56"/>
   <Setter Property="Height" Value="46"/>
   <Setter Property="HorizontalAlignment" Value="Center"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <Grid Width="56" Height="46" Background="Transparent">
       <Border x:Name="CheckFrame" Width="29" Height="29" CornerRadius="5"
        Background="#14283D" BorderBrush="#88A9C4" BorderThickness="2"
        HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="CheckMark" Text="✓" FontSize="23"
         FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
         Foreground="White" Visibility="Collapsed"/>
       </Border>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="CheckFrame" Property="Background" Value="#128464"/>
        <Setter TargetName="CheckFrame" Property="BorderBrush" Value="#35C79A"/>
        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="CheckFrame" Property="BorderBrush" Value="#80D6EF"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="CheckFrame" Property="Opacity" Value="0.4"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="MinHeight" Value="35"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Foreground" Value="#F0F5FC"/>
  </Style>
 </Application.Resources>
</Application>