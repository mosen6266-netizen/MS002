<UserControl x:Class="SignalScheduler.Desktop.AccountGroupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#071521" Foreground="#EAF2FF">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#17324E"/>
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="BorderBrush" Value="#3A5C7B"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#112941"/>
   <Setter Property="Foreground" Value="#F8FAFC"/>
   <Setter Property="BorderBrush" Value="#3E5C79"/>
   <Setter Property="CaretBrush" Value="#FFFFFF"/>
   <Setter Property="SelectionBrush" Value="#367AB2"/>
   <Setter Property="Padding" Value="7"/>
   <Style.Triggers>
    <Trigger Property="IsKeyboardFocusWithin" Value="True">
     <Setter Property="BorderBrush" Value="#7DC9FF"/>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Opacity" Value="0.6"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="Background" Value="#0A1E31"/>
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="RowBackground" Value="#0D2135"/>
   <Setter Property="AlternatingRowBackground" Value="#162E45"/>
   <Setter Property="BorderBrush" Value="#2C4660"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style TargetType="DataGridRow">
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="Background" Value="#0D2135"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="#23669B"/>
     <Setter Property="Foreground" Value="White"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="14"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" LastChildFill="False">
   <StackPanel DockPanel.Dock="Left">
    <TextBlock Text="账号与群组" FontSize="26" FontWeight="Bold"/>
    <TextBlock Text="账号备注和群组勾选会保存到本地数据库，更新软件后仍保留。"
               Margin="0,6,0,0" Foreground="#A2B9CD"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
               VerticalAlignment="Center">
    <Button Content="刷新列表" Click="Refresh_Click"/>
    <Button Content="关闭" Click="Close_Click"/>
   </StackPanel>
  </DockPanel>
  <TabControl Grid.Row="2" x:Name="ManagementTabs" MinHeight="200" Background="#0C1C2E"
              Foreground="#EDF5FF" BorderBrush="#2D4660">
   <TabItem Header="账号管理" Padding="12,8">
    <Grid Margin="14">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="2*"/>
     </Grid.ColumnDefinitions>
     <DataGrid x:Name="AccountGrid" IsReadOnly="True" AlternationCount="2"
       HeadersVisibility="Column" EnableColumnVirtualization="False"
       HorizontalAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto"
       ColumnHeaderStyle="{StaticResource DarkGridHeader}" RowHeight="48"
       SelectionMode="Single" SelectionChanged="AccountGrid_SelectionChanged">
      <DataGrid.Columns>
       <DataGridTextColumn Header="账号" Binding="{Binding Account}" Width="215" MinWidth="160"/>
       <DataGridTextColumn Header="备注" Binding="{Binding Label}" Width="205" MinWidth="140"/>
       <DataGridCheckBoxColumn Header="已启用" Binding="{Binding Enabled}" Width="85"/>
       <DataGridCheckBoxColumn Header="在线" Binding="{Binding Online}" Width="80"/>
      </DataGrid.Columns>
     </DataGrid>
     <Border Grid.Column="2" Background="#10273C" BorderBrush="#2B4663"
             BorderThickness="1" Padding="16" CornerRadius="8">
      <StackPanel>
       <TextBlock Text="编辑选中账号" FontSize="18" FontWeight="SemiBold"
                  Margin="0,0,0,12"/>
       <TextBlock Text="账号标识" Foreground="#AEC2D3"/>
       <TextBlock x:Name="AccountIdentity" Margin="0,6,0,16"
                  TextWrapping="Wrap"/>
       <TextBlock Text="备注（可自定义）" Foreground="#AEC2D3"/>
       <TextBox x:Name="AccountLabel" MaxLength="80" Margin="0,6,0,16"/>
       <CheckBox x:Name="AccountEnabled" Content="启用这个账号"
                 Margin="0,0,0,18" Foreground="White"/>
       <Button x:Name="SaveAccountButton" Content="保存账号设置"
               Background="#147747" Click="SaveAccount_Click"
               IsEnabled="False" HorizontalAlignment="Left"/>
       <TextBlock Text="禁用账号会阻止未来进入发送阶段；不会删除 Signal 登录凭证或历史数据。"
                  Margin="0,20,0,0" TextWrapping="Wrap" Foreground="#D7B77A"/>
      </StackPanel>
     </Border>
    </Grid>
   </TabItem>
   <TabItem Header="群组选择" Padding="12,8">
    <Grid Margin="14">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
       <Button Content="全选" Click="SelectAll_Click"/>
       <Button Content="取消全选" Click="ClearAll_Click"/>
      </StackPanel>
      <Button Content="保存群组选择" DockPanel.Dock="Right"
              Background="#147747" Click="SaveGroups_Click"/>
     </DockPanel>
     <DataGrid x:Name="GroupGrid" Grid.Row="1" AlternationCount="2"
      HeadersVisibility="Column" EnableColumnVirtualization="False"
      ScrollViewer.HorizontalScrollBarVisibility="Auto"
      ColumnHeaderStyle="{StaticResource DarkGridHeader}" RowHeight="48">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="选择" Width="75">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox Style="{StaticResource LargeRowCheckBox}"
           IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="群名" Width="640" MinWidth="260" IsReadOnly="True"
         Binding="{Binding Name}"/>
       <DataGridTextColumn Header="所在账号数" Width="110" IsReadOnly="True"
         Binding="{Binding MemberAccounts}"/>
       
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="2"
       Text="同一个 Signal 群即使出现在多个账号中，也只显示一次；这里仅保存勾选，不会自动开始发送。"
       Margin="0,12,0,0" Foreground="#D7B77A" TextWrapping="Wrap"/>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="4" x:Name="StatusText" Text="正在读取账号和群组资料…"
             Foreground="#AEC5DB" TextWrapping="Wrap"/>
 </Grid>
</UserControl>