<Window x:Class="SignalScheduler.Desktop.LiveProbeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="真实发送诊断（单条、需人工确认）"
 Height="625" Width="790" MinWidth="690" MinHeight="545"
 WindowStartupLocation="CenterOwner"
 Background="#091827" Foreground="#EAF3FF">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource ReadableButtonBase}">
   <Setter Property="Background" Value="#173C59"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#345878"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#1B3B55"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Padding" Value="8"/>
  </Style>
 </Window.Resources>
 <Grid Margin="25">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="15"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="20"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="20"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="18"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0">
   <TextBlock Text="Signal 真实发送诊断" FontSize="27" FontWeight="Bold"/>
   <TextBlock Text="仅发送一条带明显测试标识的消息，不会启动剧本或循环群发"
    Margin="0,6,0,0" Foreground="#F1BE78" TextWrapping="Wrap"/>
  </StackPanel>
  <Border Grid.Row="2" Background="#102B41" BorderBrush="#31516B" BorderThickness="1"
   CornerRadius="10" Padding="16">
   <StackPanel>
    <TextBlock Text="选择已经登录并启用的 Signal 账号" FontSize="15" FontWeight="SemiBold"/>
    <ComboBox x:Name="AccountBox" DisplayMemberPath="Label" Margin="0,9,0,14"/>
    <TextBlock Text="选择你已保存勾选的专用测试群" FontSize="15" FontWeight="SemiBold"/>
    <ComboBox x:Name="GroupBox" DisplayMemberPath="Name" Margin="0,9,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="4" Background="#352C23" BorderBrush="#A07338"
   BorderThickness="1" CornerRadius="10" Padding="16">
   <StackPanel>
    <TextBlock Text="发送内容（固定，不允许批量修改）" FontWeight="SemiBold"/>
    <TextBlock Text="[SignalScheduler 实发测试] 这是一条经操作者确认的单条测试消息；请勿回复。 测试编号：xxxxxxxx"
     TextWrapping="Wrap" Margin="0,9,0,0"/>
    <TextBlock Text="发送确认表示 signal-cli 已接受消息，不等于群成员全部收到或已读。"
     TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#F1BE78"/>
   </StackPanel>
  </Border>
  <CheckBox x:Name="ConsentBox" Grid.Row="6" FontSize="14" Foreground="White"
   Content="我确认这是允许测试的群组，同意立即发送一条真实 Signal 消息。"
   Checked="Consent_Changed" Unchecked="Consent_Changed"/>
  <StackPanel Grid.Row="8" Orientation="Horizontal">
   <Button x:Name="SendButton" IsEnabled="False"
    Content="发送一次真实测试消息" Background="#A34D27"
    Click="Send_Click"/>
   <Button Content="刷新账号和群组" Click="Reload_Click"/>
  </StackPanel>
  <StackPanel Grid.Row="9" Margin="0,13,0,0">
   <TextBlock x:Name="StatusText" Foreground="#BED0E5"
    TextWrapping="Wrap" Text="准备读取账号和群组…"/>
   <TextBlock Text="安全机制：需要有效在线卡密；限同一时间一条、两次之间至少 90 秒；网络超时、断线或结果未知会暂停并记录在恢复中心，不会自动重发。"
    Margin="0,12,0,0" Foreground="#F4C282" TextWrapping="Wrap"/>
  </StackPanel>
 </Grid>
</Window>
