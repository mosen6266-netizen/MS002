<ResourceDictionary
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- UI 2.0: monochrome business palette. Semantic error/success indicators
      are intentionally exempt from the decorative palette. -->
 <SolidColorBrush x:Key="Ui2Canvas" Color="#101114"/>
 <SolidColorBrush x:Key="Ui2Sidebar" Color="#141518"/>
 <SolidColorBrush x:Key="Ui2Surface" Color="#1B1D21"/>
 <SolidColorBrush x:Key="Ui2SurfaceRaised" Color="#23262A"/>
 <SolidColorBrush x:Key="Ui2SurfaceHover" Color="#31343A"/>
 <SolidColorBrush x:Key="Ui2Selected" Color="#3E4248"/>
 <SolidColorBrush x:Key="Ui2Border" Color="#383C42"/>
 <SolidColorBrush x:Key="Ui2BorderStrong" Color="#5E646C"/>
 <SolidColorBrush x:Key="Ui2Text" Color="#F3F3F4"/>
 <SolidColorBrush x:Key="Ui2TextSecondary" Color="#C3C5C9"/>
 <SolidColorBrush x:Key="Ui2TextMuted" Color="#9B9FA5"/>
 <SolidColorBrush x:Key="Ui2Focus" Color="#DDE0E3"/>
 <SolidColorBrush x:Key="Ui2DisabledBackground" Color="#35383D"/>
 <SolidColorBrush x:Key="Ui2DisabledText" Color="#F3F3F4"/>
 <SolidColorBrush x:Key="Ui2Success" Color="#72CFA7"/>
 <SolidColorBrush x:Key="Ui2Warning" Color="#E8C985"/>
 <SolidColorBrush x:Key="Ui2Danger" Color="#F57880"/>

 <Style x:Key="Ui2CardStyle" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource Ui2Surface}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Ui2Border}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="12"/>
  <Setter Property="Padding" Value="16"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
 </Style>
 <Style x:Key="Ui2SectionTitle" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{StaticResource Ui2Text}"/>
  <Setter Property="FontSize" Value="18"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
 </Style>
 <Style x:Key="Ui2SecondaryLabel" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{StaticResource Ui2TextSecondary}"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <Style x:Key="Ui2Divider" TargetType="Border">
  <Setter Property="Height" Value="1"/>
  <Setter Property="Background" Value="{StaticResource Ui2Border}"/>
 </Style>
</ResourceDictionary>