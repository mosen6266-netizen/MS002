<Window x:Class="SignalScheduler.Desktop.PreviewTasksWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="多群任务预演与运行控制 - Signal 调度台"
 Width="1220" Height="825" MinWidth="1020" MinHeight="680"
 WindowStartupLocation="CenterOwner" Background="#071521" Foreground="#EEF6FF">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource ReadableButtonBase}">
   <Setter Property="Background" Value="#17324E"/>
   <Setter Property="Foreground" Value="#EEF6FF"/>
   <Setter Property="BorderBrush" Value="#395A76"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Padding" Value="12,8"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#102338"/>
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="RowBackground" Value="#102338"/>
   <Setter Property="AlternatingRowBackground" Value="#19324C"/>
   <Setter Property="BorderBrush" Value="#33546F"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="SelectionMode" Value="Single"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
  </Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="14"/>
   <RowDefinition Height="195"/>
   <RowDefinition Height="16"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" LastChildFill="False">
   <StackPanel DockPanel.Dock="Left">
    <TextBlock Text="多群任务管理" FontSize="27" FontWeight="Bold"/>
    <TextBlock Text="当前仅预演：可验证顺序、停顿和恢复，不发送 Signal 消息"
     Foreground="#F3BD76" Margin="0,5,0,0" FontSize="13"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="刷新" Click="Refresh_Click"/>
    <Button Content="关闭" Click="Close_Click"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="2" Background="#0B2033" BorderBrush="#2A4561"
   BorderThickness="1" CornerRadius="10" Padding="16">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="16"/>
     <ColumnDefinition Width="2*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Text="1. 选择剧本" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <ListBox x:Name="ScriptsBox" DisplayMemberPath="Name" Height="115"
       Background="#102A41" Foreground="#EAF2FF"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <DockPanel LastChildFill="False">
      <TextBlock Text="2. 勾选已在群组管理中保存的群" FontSize="17"
       DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <Button Content="创建预演任务" Click="Plan_Click" DockPanel.Dock="Right"
       Background="#13774F"/>
     </DockPanel>
     <DataGrid x:Name="GroupsGrid" Height="115" AutoGenerateColumns="False"
       IsReadOnly="False" CanUserAddRows="False">
      <DataGrid.Columns>
       <DataGridCheckBoxColumn Header="选择" Width="80"
        Binding="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <DataGridTextColumn Header="群组名称" Width="3*" IsReadOnly="True" Binding="{Binding Name}"/>
       <DataGridTextColumn Header="成员账号数" Width="110" IsReadOnly="True" Binding="{Binding MemberAccounts}"/>
      </DataGrid.Columns>
     </DataGrid>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="4">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="12"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <DockPanel Grid.Row="0">
    <TextBlock Text="3. 预演运行状态" FontSize="17" FontWeight="SemiBold"
     VerticalAlignment="Center" DockPanel.Dock="Left"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="PauseButton" Content="暂停选中任务" Click="Pause_Click"/>
     <Button x:Name="ResumeButton" Content="手动继续" Click="Resume_Click"
      Background="#176D50"/>
     <Button x:Name="StopButton" Content="停止选中任务" Click="Stop_Click"
      Background="#874635"/>
    </StackPanel>
   </DockPanel>
   <DataGrid x:Name="TasksGrid" Grid.Row="2" SelectionChanged="TasksGrid_SelectionChanged"
    AlternationCount="2">
    <DataGrid.Columns>
     <DataGridTextColumn Header="剧本" Binding="{Binding Name}" Width="1.3*"/>
     <DataGridTextColumn Header="目标群" Binding="{Binding GroupName}" Width="1.3*"/>
     <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90"/>
     <DataGridTextColumn Header="当前条数" Binding="{Binding Progress}" Width="90"/>
     <DataGridTextColumn Header="详细信息 / 提醒" Binding="{Binding Detail}" Width="3*"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
  <StackPanel Grid.Row="6">
   <TextBlock x:Name="StatusText" Text="正在读取多群预演任务…"
    Foreground="#AED0EC" TextWrapping="Wrap"/>
   <TextBlock Text="重要：这不是实际发送。所有预演任务均使用 SQLite 事务记录进度，意外重启会暂停，需手动继续。剧本中的“暂停提醒”会停在下一条消息前。"
    Foreground="#EFC182" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
 </Grid>
</Window>
