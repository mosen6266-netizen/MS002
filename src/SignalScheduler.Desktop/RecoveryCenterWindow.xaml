<UserControl x:Class="SignalScheduler.Desktop.RecoveryCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#081522" Foreground="#EDF4FE">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#16304B"/>
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="BorderBrush" Value="#39516B"/>
   <Setter Property="Padding" Value="15,9"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#0C1B2B"/>
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="BorderBrush" Value="#29435E"/>
   <Setter Property="RowBackground" Value="#0C1B2B"/>
   <Setter Property="AlternatingRowBackground" Value="#13263B"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="SelectionMode" Value="Single"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="16"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0">
   <TextBlock Text="任务恢复中心" FontSize="25" FontWeight="Bold"/>
   <TextBlock Text="优先处理异常任务；所有发送结果不明确的消息必须核对，绝不会自动重发。"
              Foreground="#9DB2C9" Margin="0,6,0,10" TextWrapping="Wrap"/>
   <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
    <Button Content="刷新记录" Click="Refresh_Click" Margin="0,0,6,6"/>
    <Button x:Name="PauseButton" Content="暂停选中任务" Click="Pause_Click"
            Background="#855527" IsEnabled="False" Margin="0,0,6,6"/>
    <Button x:Name="MarkSeenButton" Content="核实已发送" Click="MarkSeen_Click"
            IsEnabled="False" Background="#146C4C" Margin="0,0,6,6"/>
    <Button x:Name="MarkNotSentButton" Content="核实未发送" Click="MarkNotSent_Click"
            IsEnabled="False" Background="#895729" Margin="0,0,6,6"/>
    <Button Content="返回首页" Click="Close_Click" Margin="0,0,6,6"/>
   </WrapPanel>
   <CheckBox x:Name="ShowAllTasks" Content="显示全部任务（包含正常暂停、已完成和旧版历史）"
    IsChecked="False" Checked="TasksFilterChanged" Unchecked="TasksFilterChanged"
    Foreground="#B7D5EE" VerticalAlignment="Center" Margin="0,0,0,2"/>
  </StackPanel>

  <Grid Grid.Row="2">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <TextBlock Text="需要处理的任务（可勾选显示全部）" FontSize="16" FontWeight="SemiBold"
              Margin="0,0,0,10"/>
   <DataGrid x:Name="JobsGrid" EnableColumnVirtualization="False"
             HeadersVisibility="Column" ScrollViewer.HorizontalScrollBarVisibility="Auto" Grid.Row="1" Height="320" AlternationCount="2"
             SelectionChanged="JobsGrid_SelectionChanged">
    <DataGrid.Columns>
     <DataGridTextColumn Header="任务" Binding="{Binding Name}" Width="260"
      ElementStyle="{StaticResource TruncatedGridText}"/>
     <DataGridTextColumn Header="状态" Binding="{Binding StateDisplay}" Width="180"/>
     <DataGridTextColumn Header="当前消息序号" Binding="{Binding Cursor}" Width="100"/>
     <DataGridTextColumn Header="异常原因 / 任务说明" Binding="{Binding Detail}" Width="340"
      ElementStyle="{StaticResource TruncatedGridText}"/>
     <DataGridCheckBoxColumn Header="旧版记录" Binding="{Binding IsLegacy}" Width="82"/>
     <DataGridCheckBoxColumn Header="需要人工核对" Binding="{Binding NeedsReview}" Width="116"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>

  <Grid Grid.Row="4">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,10">
    <TextBlock Text="所选任务的发送审计记录" FontSize="16"
               FontWeight="SemiBold" DockPanel.Dock="Left"/>
    <Button Content="复制选中记录" DockPanel.Dock="Right"
            Click="Copy_Click" HorizontalAlignment="Right"/>
   </DockPanel>
<DataGrid x:Name="DispatchGrid" EnableColumnVirtualization="False"
             HeadersVisibility="Column" ScrollViewer.HorizontalScrollBarVisibility="Auto" Grid.Row="1" Height="400" AlternationCount="2"
             SelectionChanged="DispatchGrid_SelectionChanged">
    <DataGrid.Columns>
     <DataGridTextColumn Header="消息序号" Binding="{Binding Cursor}" Width="75"/>
     <DataGridTextColumn Header="发送状态" Binding="{Binding StateDisplay}" Width="150"/>
     <DataGridTextColumn Header="账号备注" Binding="{Binding AccountDisplay}" Width="140"/>
     <DataGridTextColumn Header="群组" Binding="{Binding GroupDisplay}" Width="160"/>
     <DataGridTextColumn Header="提供方消息 ID" Binding="{Binding ProviderMessageId}" Width="180"/>
     <DataGridTextColumn Header="异常 / 说明" Binding="{Binding Detail}" Width="330"
      ElementStyle="{StaticResource TruncatedGridText}"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>

  <StackPanel Grid.Row="5" Margin="0,14,0,0">
   <TextBlock Text="只有在 Signal 真实核对消息后，才可裁定 RecoveryRequired。核实已发送会跳过该条；核实未发送允许稍后手动继续。所有裁定都会永久写入审计日志，不能撤回。"
              TextWrapping="Wrap" Foreground="#F1BD75"/>
   <TextBox x:Name="EvidenceBox" MaxLength="500"
     Margin="0,9,0,0" Padding="8" Foreground="White"
     Background="#142D46" BorderBrush="#3A5E7A"
     ToolTip="写明 Signal 中核对的结果，例如群名、消息内容或时间；至少 8 个字符。"/>
   <TextBlock x:Name="StatusText" Text="正在读取任务记录…" Margin="0,7,0,0"
              Foreground="#9CB6D2" TextWrapping="Wrap"/>
  </StackPanel>
 </Grid>
</UserControl>