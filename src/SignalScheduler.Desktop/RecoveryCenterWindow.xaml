<Window x:Class="SignalScheduler.Desktop.RecoveryCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="任务恢复中心 - Signal 调度台" Width="1120" Height="760"
 MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner"
 Background="#081522" Foreground="#EDF4FE">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#16304B"/>
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="BorderBrush" Value="#39516B"/>
   <Setter Property="Padding" Value="15,9"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#0C1B2B"/>
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="BorderBrush" Value="#29435E"/>
   <Setter Property="RowBackground" Value="#0C1B2B"/>
   <Setter Property="AlternatingRowBackground" Value="#13263B"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="SelectionMode" Value="Single"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
  </Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="16"/>
   <RowDefinition Height="2*"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="3*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0">
   <StackPanel DockPanel.Dock="Left">
    <TextBlock Text="任务恢复中心" FontSize="25" FontWeight="Bold"/>
    <TextBlock Text="查看发送日志、人工暂停任务。未确认消息不会自动重发。"
               Foreground="#9DB2C9" Margin="0,6,0,0"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
               HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="刷新记录" Click="Refresh_Click"/>
    <Button x:Name="PauseButton" Content="暂停选中任务" Click="Pause_Click"
            Background="#855527" IsEnabled="False"/>
    <Button Content="关闭" Click="Close_Click"/>
   </StackPanel>
  </DockPanel>

  <Grid Grid.Row="2">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <TextBlock Text="任务列表（包含旧版历史任务）" FontSize="16" FontWeight="SemiBold"
              Margin="0,0,0,10"/>
   <DataGrid x:Name="JobsGrid" Grid.Row="1" AlternationCount="2"
             SelectionChanged="JobsGrid_SelectionChanged">
    <DataGrid.Columns>
     <DataGridTextColumn Header="任务" Binding="{Binding Name}" Width="3*"/>
     <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="2*"/>
     <DataGridTextColumn Header="当前消息序号" Binding="{Binding Cursor}" Width="*"/>
     <DataGridCheckBoxColumn Header="旧版记录" Binding="{Binding IsLegacy}" Width="*"/>
     <DataGridCheckBoxColumn Header="需要人工核对" Binding="{Binding NeedsReview}" Width="*"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>

  <Grid Grid.Row="4">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,10">
    <TextBlock Text="所选任务的发送审计记录" FontSize="16"
               FontWeight="SemiBold" DockPanel.Dock="Left"/>
    <Button Content="复制选中记录" DockPanel.Dock="Right"
            Click="Copy_Click" HorizontalAlignment="Right"/>
   </DockPanel>
   <DataGrid x:Name="DispatchGrid" Grid.Row="1" AlternationCount="2">
    <DataGrid.Columns>
     <DataGridTextColumn Header="消息序号" Binding="{Binding Cursor}" Width="75"/>
     <DataGridTextColumn Header="发送状态" Binding="{Binding State}" Width="150"/>
     <DataGridTextColumn Header="账号" Binding="{Binding AccountId}" Width="140"/>
     <DataGridTextColumn Header="群组 ID" Binding="{Binding GroupId}" Width="160"/>
     <DataGridTextColumn Header="提供方消息 ID" Binding="{Binding ProviderMessageId}" Width="180"/>
     <DataGridTextColumn Header="异常 / 说明" Binding="{Binding Detail}" Width="2*"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>

  <StackPanel Grid.Row="5" Margin="0,14,0,0">
   <TextBlock Text="注意：暂停会保存到本地数据库，但不能撤回正在发送的消息。对于 RecoveryRequired，请先核对实际发送结果。V8 测试版暂不支持继续发送。"
              TextWrapping="Wrap" Foreground="#F1BD75"/>
   <TextBlock x:Name="StatusText" Text="正在读取任务记录…" Margin="0,7,0,0"
              Foreground="#9CB6D2" TextWrapping="Wrap"/>
  </StackPanel>
 </Grid>
</Window>
