<Window x:Class="SignalScheduler.Desktop.LivePilotWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="单群自动实发测试 - Signal 调度台"
 Width="980" Height="750" MinWidth="850" MinHeight="650"
 WindowStartupLocation="CenterOwner"
 Background="{StaticResource Ui2Canvas}" Foreground="{StaticResource Ui2Text}">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource ReadableButtonBase}">
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
   <Setter Property="Background" Value="#222529"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#41454B"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#222529"/>
   <Setter Property="Padding" Value="8"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#191B1E"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="RowBackground" Value="#191B1E"/>
   <Setter Property="AlternatingRowBackground" Value="#222529"/>
   <Setter Property="BorderBrush" Value="#2D3035"/>
   <Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="IsReadOnly" Value="True"/>
  </Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="14"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="13"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="14"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0">
   <TextBlock Text="受控自动实发测试" FontSize="27" FontWeight="Bold"/>
   <TextBlock Text="一个账号 + 一个测试群 + 最多三条真实消息。每条至少间隔 15 秒；异常立即停止后续。"
    Foreground="#F2C086" TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel>
  <Border Grid.Row="2" Background="{StaticResource Ui2Surface}" Padding="14" CornerRadius="8"
   BorderBrush="{StaticResource Ui2BorderStrong}" BorderThickness="1">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/><ColumnDefinition Width="13"/>
     <ColumnDefinition Width="*"/><ColumnDefinition Width="13"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Text="测试剧本" FontWeight="SemiBold"/>
     <ComboBox x:Name="ScriptBox" DisplayMemberPath="Name" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <TextBlock Text="唯一发送账号" FontWeight="SemiBold"/>
     <ComboBox x:Name="AccountBox" DisplayMemberPath="Account" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="4">
     <TextBlock Text="测试群" FontWeight="SemiBold"/>
     <ComboBox x:Name="GroupBox" DisplayMemberPath="Name" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="4">
   <CheckBox x:Name="ConfirmBox" Foreground="White"
    Content="我确认群组成员同意测试，并了解这会自动真实发送最多三条消息。"
    Checked="Consent_Changed" Unchecked="Consent_Changed"/>
   <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
    <Button x:Name="StartButton" IsEnabled="False" Content="启动一次真实自动测试"
     Background="#A64C31" Click="Start_Click"/>
    <Button Content="刷新账号、剧本、群组" Click="Refresh_Click"/>
   </StackPanel>
  </StackPanel>
  <Border Grid.Row="6" Padding="12" CornerRadius="6" Background="#302C27"
   BorderBrush="#795D3B" BorderThickness="1">
   <TextBlock Text="仅测试文本，剧本最多三条消息，每条不超过 300 字；原图发送、多群并发及正式运行仍未开放。所有发送内容均带测试标识。"
    TextWrapping="Wrap" Foreground="#F7D09C"/>
  </Border>
  <Grid Grid.Row="8">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <DockPanel Grid.Row="0">
    <TextBlock Text="真实任务状态" FontSize="17" FontWeight="SemiBold"
     DockPanel.Dock="Left" VerticalAlignment="Center"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click"/>
     <Button x:Name="ResumeButton" Content="人工继续" Click="Resume_Click"
      Background="#146C54"/>
     <Button x:Name="StopButton" Content="停止" Click="Stop_Click"
      Background="#87432A"/>
    </StackPanel>
   </DockPanel>
   <DataGrid Grid.Row="2" x:Name="JobGrid"
    SelectionChanged="JobGrid_SelectionChanged" AutoGenerateColumns="False">
    <DataGrid.Columns>
     <DataGridTextColumn Header="剧本" Binding="{Binding ScriptName}" Width="1.5*"/>
     <DataGridTextColumn Header="群名" Binding="{Binding GroupName}" Width="1.2*"/>
     <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="120"/>
     <DataGridTextColumn Header="进度" Binding="{Binding Progress}" Width="70"/>
     <DataGridTextColumn Header="事件 / 提醒" Binding="{Binding Detail}" Width="3*"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="10"
   Text="正在读取测试资料……" TextWrapping="Wrap" Foreground="{StaticResource Ui2TextSecondary}"/>
 </Grid>
</Window>
