<Window x:Class="SignalScheduler.Desktop.LinkAccountWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="扫码登录 Signal" Height="560" Width="460"
 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
 Background="#07111F" Foreground="#EAF2FF">
 <Grid Margin="24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="18"/>
   <RowDefinition Height="330"/>
   <RowDefinition Height="14"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="扫码登录 Signal" FontSize="26" FontWeight="Bold"/>
   <TextBlock Text="打开手机 Signal → 设置 → 已连接的设备 → 连接新设备" Margin="0,7,0,0" Foreground="#9CB1C9" TextWrapping="Wrap"/>
  </StackPanel>
  <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="18" HorizontalAlignment="Center" Width="320" Height="320">
   <Image x:Name="QrImage" Stretch="Uniform"/>
  </Border>
  <TextBlock Grid.Row="4" x:Name="StatusText" Text="正在创建二维码…" HorizontalAlignment="Center" TextAlignment="Center" FontSize="15" TextWrapping="Wrap"/>
  <TextBlock Grid.Row="5" x:Name="DetailText" Margin="0,10,0,0" Foreground="#9CB1C9" TextAlignment="Center" TextWrapping="Wrap"/>
  <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
   <Button Content="重新生成" Click="Regenerate_Click" Padding="16,8" Margin="0,0,10,0"/>
   <Button Content="关闭" Click="Close_Click" Padding="22,8"/>
  </StackPanel>
 </Grid>
</Window>
