<Window x:Class="SignalScheduler.Desktop.LinkAccountWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="连接 Signal 账号" Height="765" Width="560" MinHeight="740"
 WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
 Background="#111215" Foreground="#F1F2F4">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource ReadableButtonBase}">
   <Setter Property="Background" Value="#222529"/>
   <Setter Property="Foreground" Value="#FFFFFF"/>
   <Style.Triggers>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Background" Value="#2D3035"/>
     <Setter Property="Foreground" Value="#D0D2D7"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="FinishAccountButton" TargetType="Button" BasedOn="{StaticResource ReadableButtonBase}">
   <Setter Property="Background" Value="#117D5B"/>
   <Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#2EA981"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}"
       CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
        RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Background" Value="#292E36"/>
     <Setter Property="Foreground" Value="#F6F7FA"/>
     <Setter Property="BorderBrush" Value="#2D3035"/>
     <Setter Property="Cursor" Value="Arrow"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="#18976D"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="28,24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="17"/>
   <RowDefinition Height="296"/><RowDefinition Height="20"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="18"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="扫码连接账号" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock Text="手机 Signal → 设置 → 已连接设备 → 连接新设备"
     Foreground="#D0D2D7" Margin="0,7,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <Border Grid.Row="2" Background="White" CornerRadius="13"
   Padding="17" Width="295" Height="295" HorizontalAlignment="Center">
   <Image x:Name="QrImage" Stretch="Uniform"/>
  </Border>
  <StackPanel Grid.Row="4">
   <TextBlock Text="账号备注" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBox x:Name="RemarkBox" MaxLength="80" Height="44"
    VerticalContentAlignment="Center" FontSize="14"
    Background="#222529" BorderBrush="#555A61"
    Foreground="#F4F7FD" Padding="12,7"
    ToolTip="例如：工作号1；备注仅保存在本地，可随时修改"/>
   <TextBlock Text="在这里直接填写，扫码成功后将自动保存到账号管理。可留空稍后设置。"
    Margin="0,6,0,0" Foreground="#D0D2D7" FontSize="12" TextWrapping="Wrap"/>
  </StackPanel>
  <Border Grid.Row="6" Background="#191B1E" CornerRadius="8"
   Padding="12,10">
   <StackPanel>
    <TextBlock x:Name="StatusText" Text="正在创建二维码…"
     FontSize="14" FontWeight="SemiBold" Foreground="#D0D2D7"
     TextWrapping="Wrap"/>
    <TextBlock x:Name="DetailText" Foreground="#D0D2D7" FontSize="12"
     TextWrapping="Wrap" Margin="0,5,0,0"/>
   </StackPanel>
  </Border>
  <StackPanel Grid.Row="8" Orientation="Horizontal"
   HorizontalAlignment="Right">
   <Button Content="重新生成二维码" Click="Regenerate_Click"
    Background="#222529" Foreground="White" BorderBrush="#555A61"
    Padding="14,9" MinHeight="40" Margin="0,0,10,0"/>
   <Button x:Name="FinishButton" Content="保存备注并完成"
    Click="Finish_Click" IsEnabled="False"
    Style="{StaticResource FinishAccountButton}"
    Padding="17,9" MinHeight="40" Margin="0,0,10,0"/>
   <Button Content="取消" Click="Close_Click"
    Background="#222529" Foreground="White"
    Padding="15,9" MinHeight="40"/>
  </StackPanel>
 </Grid>
</Window>