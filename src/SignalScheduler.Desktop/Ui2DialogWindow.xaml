<Window x:Class="SignalScheduler.Desktop.Ui2DialogWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MS002 · 提醒"
 Width="540" MinWidth="430" MaxWidth="700"
 SizeToContent="Height" MaxHeight="700"
 WindowStartupLocation="CenterOwner"
 ResizeMode="NoResize" WindowStyle="None"
 ShowInTaskbar="False"
 Background="{StaticResource Ui2SurfaceRaised}"
 Foreground="{StaticResource Ui2Text}"
 FontFamily="Segoe UI"
 UseLayoutRounding="True"
 SnapsToDevicePixels="True">
 <Border Background="{StaticResource Ui2SurfaceRaised}"
  BorderBrush="{StaticResource Ui2BorderStrong}"
  BorderThickness="1" CornerRadius="14"
  Padding="24" SnapsToDevicePixels="True">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="14"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="20"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Grid Grid.Row="0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="38"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border x:Name="DialogIconFace" Width="31" Height="31"
     CornerRadius="8" Background="{StaticResource Ui2Selected}">
     <TextBlock x:Name="DialogIcon" Text="i" Foreground="{StaticResource Ui2Text}"
      FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"
      VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1">
     <TextBlock x:Name="DialogHeading" FontSize="19"
      FontWeight="SemiBold" Foreground="{StaticResource Ui2Text}"
      TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="MS002 · 操作提醒" FontSize="11"
      Foreground="{StaticResource Ui2TextMuted}" Margin="0,5,0,0"/>
    </StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="2" MaxHeight="430"
    VerticalScrollBarVisibility="Auto"
    HorizontalScrollBarVisibility="Disabled">
    <TextBlock x:Name="DialogMessage" FontSize="14" LineHeight="23"
     TextWrapping="Wrap" Foreground="{StaticResource Ui2TextSecondary}"/>
   </ScrollViewer>
   <StackPanel Grid.Row="4" Orientation="Horizontal"
    HorizontalAlignment="Right">
    <Button x:Name="SecondaryButton" Content="取消"
     Background="{StaticResource Ui2SurfaceHover}"
     Foreground="{StaticResource Ui2Text}"
     BorderBrush="{StaticResource Ui2BorderStrong}"
     MinWidth="104" MinHeight="40" Margin="0,0,10,0"/>
    <Button x:Name="PrimaryButton" Content="确定"
     Background="{StaticResource Ui2Selected}"
     Foreground="{StaticResource Ui2Text}"
     BorderBrush="{StaticResource Ui2BorderStrong}"
     MinWidth="112" MinHeight="40" FontWeight="SemiBold"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>