<UserControl x:Class="SignalScheduler.Desktop.RunningTasksWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#091827" Foreground="#EAF4FD" MinWidth="620">
 <UserControl.Resources>
  <Style x:Key="MonitorAction" TargetType="Button">
   <Setter Property="Background" Value="#1C3B56"/>
   <Setter Property="Foreground" Value="#EAF4FD"/>
   <Setter Property="BorderBrush" Value="#3D6483"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="0,0,8,7"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Opacity" Value="0.55"/>
     <Setter Property="Cursor" Value="Arrow"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <StackPanel Margin="22,20,22,28">
  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="运行任务监控" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock Text="查看各群任务的真实状态、下一句等待时间和发送结果；不会自动恢复已暂停的任务。"
    Foreground="#ADC4D9" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <Border Background="#122A40" BorderBrush="#31536F" BorderThickness="1"
   CornerRadius="8" Padding="15" Margin="0,0,0,13">
   <WrapPanel>
    <TextBlock x:Name="AllCountText" Text="任务总数：—" Margin="0,0,22,6"
     FontWeight="SemiBold" Foreground="#DCEAFF"/>
    <TextBlock x:Name="RunningCountText" Text="运行：—" Margin="0,0,22,6"
     Foreground="#7FE2BF"/>
    <TextBlock x:Name="PausedCountText" Text="暂停：—" Margin="0,0,22,6"
     Foreground="#E9CD93"/>
    <TextBlock x:Name="AttentionCountText" Text="需处理：—" Margin="0,0,12,6"
     Foreground="#FFBFA4"/>
   </WrapPanel>
  </Border>
  <WrapPanel Margin="0,0,0,8" Orientation="Horizontal">
   <TextBlock Text="显示：" VerticalAlignment="Center" Margin="0,0,7,7"/>
   <ComboBox x:Name="TaskFilter" Width="176" Margin="0,0,12,7"
    SelectionChanged="FilterChanged" SelectedIndex="0">
    <ComboBoxItem Content="运行中与已暂停" Tag="active"/>
    <ComboBoxItem Content="需要人工关注" Tag="attention"/>
    <ComboBoxItem Content="已结束任务" Tag="finished"/>
    <ComboBoxItem Content="全部任务" Tag="all"/>
   </ComboBox>
   <Button Content="立即刷新" Click="Refresh_Click"
    Style="{StaticResource MonitorAction}"/>
   <CheckBox x:Name="AutoRefreshCheck" Content="每 2 秒自动刷新"
    IsChecked="True" VerticalAlignment="Center" Margin="7,0,12,7"
    Foreground="#B8D4E8"/>
   <Button Content="打开异常恢复中心" Click="OpenRecovery_Click"
    Style="{StaticResource MonitorAction}"/>
  </WrapPanel>
  <DockPanel Margin="0,0,0,8">
   <TextBlock DockPanel.Dock="Left" x:Name="JobsPageLabel"
    Text="第 1 / 1 页" Foreground="#AFCBE0" VerticalAlignment="Center"/>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
    HorizontalAlignment="Right">
    <Button x:Name="PreviousPageButton" Content="上一页"
     Click="PreviousPage_Click" Style="{StaticResource MonitorAction}"/>
    <Button x:Name="NextPageButton" Content="下一页"
     Click="NextPage_Click" Style="{StaticResource MonitorAction}"/>
   </StackPanel>
  </DockPanel>
  <DataGrid x:Name="MonitorGrid" EnableColumnVirtualization="False"
   HeadersVisibility="Column" ScrollViewer.HorizontalScrollBarVisibility="Auto" Height="487" Background="#11283C"
   ColumnHeaderHeight="42" RowHeight="43"
   Foreground="#EAF4FD" BorderBrush="#34516C"
   RowBackground="#152C43" AlternatingRowBackground="#1B3851"
   AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
   SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
   EnableRowVirtualization="True" EnableColumnVirtualization="True"
   SelectionChanged="MonitorGrid_SelectionChanged"
   ScrollViewer.HorizontalScrollBarVisibility="Auto">
   <DataGrid.Columns>
    <DataGridTextColumn Header="剧本" Binding="{Binding ScriptName}" Width="155"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTextColumn Header="群组" Binding="{Binding GroupName}" Width="155"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTextColumn Header="任务状态" Binding="{Binding StateDisplay}" Width="108"/>
    <DataGridTextColumn Header="当前阶段" Binding="{Binding Phase}" Width="154"/>
    <DataGridTextColumn Header="发送进度" Binding="{Binding Progress}" Width="84"/>
    <DataGridTextColumn Header="下句等待" Binding="{Binding NextCountdown}" Width="118"/>
    <DataGridTextColumn Header="剩余时间估算" Binding="{Binding RemainingEstimate}" Width="180"/>
    <DataGridTextColumn Header="最早完成时间" Binding="{Binding EarliestFinish}" Width="170"/>
    <DataGridTextColumn Header="任务说明" Binding="{Binding Detail}" Width="240"
     ElementStyle="{StaticResource TruncatedGridText}"/>
   </DataGrid.Columns>
  </DataGrid>
  <Border Background="#11273A" BorderBrush="#30526C" BorderThickness="1"
   CornerRadius="8" Padding="15" Margin="0,14,0,0">
   <StackPanel>
    <TextBlock Text="选中任务详情" FontSize="16" FontWeight="SemiBold"
     Margin="0,0,0,6"/>
    <TextBlock x:Name="SelectedTaskText" Text="选择上表中的群组任务查看详情。"
     TextWrapping="Wrap" Foreground="#B6CFE4" Margin="0,0,0,11"/>
    <WrapPanel>
     <Button x:Name="PauseTaskButton" Content="暂停选中任务"
      Click="PauseTask_Click" Style="{StaticResource MonitorAction}" IsEnabled="False"/>
     <Button x:Name="ResumeTaskButton" Content="手动继续"
      Click="ResumeTask_Click" Style="{StaticResource MonitorAction}"
      Background="#156D53" IsEnabled="False"/>
     <Button x:Name="StopTaskButton" Content="停止任务"
      Click="StopTask_Click" Style="{StaticResource MonitorAction}"
      Background="#8C4246" IsEnabled="False"/>
    </WrapPanel>
    <TextBlock Text="剩余时间为下限估算，不包含账号排队、网络、发送与回执耗时；发送结果不明确时请到恢复中心核对。"
     Foreground="#95B5CF" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <TextBlock x:Name="StatusText" Text="正在读取任务状态…"
   Foreground="#ADC5DB" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </StackPanel>
</UserControl>