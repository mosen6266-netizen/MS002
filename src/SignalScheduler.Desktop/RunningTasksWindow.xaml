<UserControl x:Class="SignalScheduler.Desktop.RunningTasksWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource Ui2Canvas}" Foreground="{StaticResource Ui2Text}" MinWidth="620">
 <UserControl.Resources>
  <Style x:Key="MonitorAction" TargetType="Button" BasedOn="{StaticResource ReadableButtonBase}">
   <Setter Property="Background" Value="#222529"/>
   <Setter Property="Foreground" Value="#F1F2F4"/>
   <Setter Property="BorderBrush" Value="#41454B"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="0,0,8,7"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Cursor" Value="Arrow"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Margin="18,12,18,12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,7">
   <TextBlock Text="当前运行任务" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock Text="仅显示运行中、暂停及等待处理的任务；已停止、已完成及彻底失败的任务请到历史记录查看。"
    Foreground="{StaticResource Ui2TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock x:Name="ReceiptStatusText" Text="已读回执诊断：正在读取…"
    Foreground="{StaticResource Ui2TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Background="{StaticResource Ui2Surface}" BorderBrush="{StaticResource Ui2SurfaceHover}" BorderThickness="1"
   CornerRadius="8" Padding="15" Margin="0,0,0,13">
   <WrapPanel>
    <TextBlock x:Name="AllCountText" Text="当前任务：—" Margin="0,0,22,6"
     FontWeight="SemiBold" Foreground="{StaticResource Ui2Text}"/>
    <TextBlock x:Name="RunningCountText" Text="运行：—" Margin="0,0,22,6"
     Foreground="#7FE2BF"/>
    <TextBlock x:Name="PausedCountText" Text="暂停：—" Margin="0,0,22,6"
     Foreground="#E9CD93"/>
    <TextBlock x:Name="AttentionCountText" Text="需处理：—" Margin="0,0,12,6"
     Foreground="#FFBFA4"/>
   </WrapPanel>
  </Border>
  <WrapPanel Grid.Row="2" Margin="0,0,0,8" Orientation="Horizontal">
   <TextBlock Text="显示：" VerticalAlignment="Center" Margin="0,0,7,7"/>
   <ComboBox x:Name="TaskFilter" Width="194" Margin="0,0,12,7"
    SelectionChanged="FilterChanged" SelectedIndex="0">
    <ComboBoxItem Content="当前任务（不含已结束）" Tag="active"/>
    <ComboBoxItem Content="需要人工关注" Tag="attention"/>
    <ComboBoxItem Content="暂停及待处理" Tag="paused"/>
    <ComboBoxItem Content="全部未结束任务" Tag="all"/>
   </ComboBox>
   <Button Content="立即刷新" Click="Refresh_Click"
    Style="{StaticResource MonitorAction}"/>
   <CheckBox x:Name="AutoRefreshCheck" Content="每 2 秒自动刷新"
    IsChecked="True" VerticalAlignment="Center" Margin="7,0,12,7"
    Foreground="{StaticResource Ui2TextSecondary}"/>
   <Button Content="打开异常恢复中心" Click="OpenRecovery_Click"
    Style="{StaticResource MonitorAction}"/>
   <Button Content="查看已结束任务（历史记录）" Click="OpenHistory_Click"
    Style="{StaticResource MonitorAction}"/>
  </WrapPanel>
  <DockPanel Grid.Row="3" Margin="0,0,0,8">
   <TextBlock DockPanel.Dock="Left" x:Name="JobsPageLabel"
    Text="第 1 / 1 页" Foreground="{StaticResource Ui2TextSecondary}" VerticalAlignment="Center"/>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
    HorizontalAlignment="Right">
    <Button x:Name="PreviousPageButton" Content="上一页"
     Click="PreviousPage_Click" Style="{StaticResource MonitorAction}"/>
    <Button x:Name="NextPageButton" Content="下一页"
     Click="NextPage_Click" Style="{StaticResource MonitorAction}"/>
   </StackPanel>
  </DockPanel>
  <DataGrid x:Name="MonitorGrid" Grid.Row="4" EnableColumnVirtualization="False"
   HeadersVisibility="Column" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{StaticResource Ui2Surface}"
   ColumnHeaderHeight="42" RowHeight="43"
   Foreground="{StaticResource Ui2Text}" BorderBrush="{StaticResource Ui2SurfaceHover}"
   RowBackground="{StaticResource Ui2Surface}" AlternatingRowBackground="{StaticResource Ui2SurfaceRaised}"
   AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
   SelectionMode="Single" SelectionUnit="FullRow"
   EnableRowVirtualization="True"
   SelectionChanged="MonitorGrid_SelectionChanged">
   <DataGrid.CellStyle>
    <Style TargetType="{x:Type DataGridCell}">
     <Setter Property="Background" Value="Transparent"/>
     <Setter Property="BorderBrush" Value="Transparent"/>
     <Setter Property="Foreground" Value="#F4F8FD"/>
     <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
       <Setter Property="BorderBrush" Value="#D0D2D7"/>
       <Setter Property="BorderThickness" Value="0,0,0,1"/>
      </Trigger>
     </Style.Triggers>
    </Style>
   </DataGrid.CellStyle>
   <DataGrid.RowStyle>
    <Style TargetType="{x:Type DataGridRow}">
     <Setter Property="Foreground" Value="#F1F2F4"/>
     <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
       <Setter Property="BorderBrush" Value="#D0D2D7"/>
       <Setter Property="BorderThickness" Value="1"/>
      </Trigger>
      <DataTrigger Binding="{Binding State}" Value="Paused">
       <Setter Property="Background" Value="#8A2E39"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="RecoveryRequired">
       <Setter Property="Background" Value="#AD303B"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Failed">
       <Setter Property="Background" Value="#9E2835"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="WaitingSignal">
       <Setter Property="Background" Value="#963540"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Stopping">
       <Setter Property="Background" Value="#702D36"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Stopped">
       <Setter Property="Background" Value="#5D2A32"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </DataGrid.RowStyle>
   <DataGrid.Columns>
    <DataGridTextColumn Header="剧本" Binding="{Binding ScriptName}" Width="2*" MinWidth="100"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTextColumn Header="群组" Binding="{Binding GroupName}" Width="2*" MinWidth="100"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTemplateColumn Header="运行状态" Width="150" MinWidth="135">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <Border x:Name="StatePill" Background="#682733"
        CornerRadius="6" Padding="7,5" Margin="2,3"
        HorizontalAlignment="Stretch">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <TextBlock x:Name="StateIcon" Text="●" FontSize="17"
          FontWeight="Bold" Foreground="#FF5368" Margin="0,0,7,0"
          VerticalAlignment="Center"/>
         <TextBlock x:Name="StateName" Text="{Binding StateDisplay}"
          FontSize="13" FontWeight="Bold" Foreground="#FFF4F6"
          VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Border>
       <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Running">
         <Setter TargetName="StatePill" Property="Background" Value="#164A38"/>
         <Setter TargetName="StateIcon" Property="Text" Value="✔"/>
         <Setter TargetName="StateIcon" Property="Foreground" Value="#49E4A0"/>
         <Setter TargetName="StateName" Property="Foreground" Value="#B5FFE0"/>
        </DataTrigger>
       </DataTemplate.Triggers>
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="发送进度" Binding="{Binding Progress}" Width="90"/>
    <DataGridTextColumn Header="当前阶段" Binding="{Binding Phase}" Width="140"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTextColumn Header="下句等待" Binding="{Binding NextCountdown}" Width="110"/>
    <DataGridTextColumn Header="剩余时间" Binding="{Binding RemainingEstimate}" Width="145"
     ElementStyle="{StaticResource TruncatedGridText}"/>
   </DataGrid.Columns>
  </DataGrid>
  <Border Grid.Row="5" Background="{StaticResource Ui2Surface}" BorderBrush="{StaticResource Ui2SurfaceHover}" BorderThickness="1"
   CornerRadius="8" Padding="15" Margin="0,14,0,0">
   <StackPanel>
    <TextBlock Text="选中任务详情" FontSize="16" FontWeight="SemiBold"
     Margin="0,0,0,6"/>
    <TextBlock x:Name="SelectedTaskText" Text="选择上表中的群组任务查看详情。"
     TextWrapping="Wrap" Foreground="{StaticResource Ui2TextSecondary}" Margin="0,0,0,11"/>
    <WrapPanel>
     <Button x:Name="PauseTaskButton" Content="暂停选中任务"
      Click="PauseTask_Click" Style="{StaticResource MonitorAction}" IsEnabled="False"/>
     <Button x:Name="ResumeTaskButton" Content="手动继续"
      Click="ResumeTask_Click" Style="{StaticResource MonitorAction}"
      Background="#156D53" IsEnabled="False"/>
     <Button x:Name="StopTaskButton" Content="停止任务"
      Click="StopTask_Click" Style="{StaticResource MonitorAction}"
      Background="#8C4246" IsEnabled="False"/>
    </WrapPanel>
    <TextBlock Text="剩余时间为下限估算，不包含账号排队、网络、发送与回执耗时；发送结果不明确时请到恢复中心核对。"
     Foreground="{StaticResource Ui2TextMuted}" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <TextBlock Grid.Row="6" x:Name="StatusText" Text="正在读取任务状态…"
   Foreground="{StaticResource Ui2TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </Grid>
</UserControl>