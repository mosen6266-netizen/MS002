<Window x:Class="SignalScheduler.Desktop.LiveBatchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="多群剧本运行 - Signal 调度台"
 Width="1210" Height="850" MinWidth="1030" MinHeight="680"
 WindowStartupLocation="CenterOwner"
 Background="#081523" Foreground="#EAF4FF">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Background" Value="#173651"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#365B76"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="#10273A"/>
   <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#10273A"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="RowBackground" Value="#10273A"/>
   <Setter Property="AlternatingRowBackground" Value="#1B3650"/>
   <Setter Property="BorderBrush" Value="#31536D"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="CanUserAddRows" Value="False"/>
  </Style>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="14"/>
   <RowDefinition Height="245"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0">
   <StackPanel DockPanel.Dock="Left">
    <TextBlock Text="多群剧本调度" FontSize="28" FontWeight="Bold"/>
    <TextBlock Text="真实运行：多账号按角色发言 · 多群独立任务 · 图片附件 · 间隔与输入状态"
      Margin="0,5,0,0" Foreground="#AFC7E2"/>
   </StackPanel>
   <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
       Content="刷新全部" Click="Refresh_Click"/>
  </DockPanel>
  <Border Grid.Row="2" Background="#102337" BorderBrush="#2A4862"
    BorderThickness="1" CornerRadius="10" Padding="16">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="260"/>
     <ColumnDefinition Width="14"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Text="① 选择剧本" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <ListBox x:Name="ScriptBox" DisplayMemberPath="Name" Height="164"/>
     <TextBlock Text="使用剧本保存时的消息顺序和账号分配。"
        Margin="0,8,0,0" Foreground="#A8BED5" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Column="2">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left" Text="② 选择目标群组（最多 20 个）"
       FontSize="17" FontWeight="SemiBold"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
       <Button Content="全选" Click="SelectAll_Click"/>
       <Button Content="取消全选" Click="ClearAll_Click"/>
      </StackPanel>
     </DockPanel>
     <DataGrid x:Name="GroupsGrid" Grid.Row="1" AlternationCount="2"
        IsReadOnly="False" CanUserAddRows="False">
      <DataGrid.Columns>
       <DataGridCheckBoxColumn Header="运行" Width="75"
        Binding="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <DataGridTextColumn Header="Signal 群名" Width="3*" IsReadOnly="True"
        Binding="{Binding Name}"/>
       <DataGridTextColumn Header="成员账号数" Width="105" IsReadOnly="True"
        Binding="{Binding MemberAccounts}"/>
       <DataGridTextColumn Header="群组编号" Width="2*" IsReadOnly="True"
        Binding="{Binding GroupId}"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="2" Text="一个群只生成一个任务；已停用或不在群内的账号无法发送。"
       Foreground="#A8BED5" Margin="0,8,0,0"/>
    </Grid>
   </Grid>
  </Border>
  <DockPanel Grid.Row="4">
   <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
    <CheckBox x:Name="ConsentBox" Content="我确认选中的群组允许发送该剧本，立即开始真实发送。"
       Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"
       Checked="Consent_Changed" Unchecked="Consent_Changed"/>
    <TextBlock Text="异常、断线、退出后任务会暂停，不会自动重发；关闭本窗口不停止后台任务。"
       Foreground="#E5C18C"/>
   </StackPanel>
   <Button x:Name="StartButton" DockPanel.Dock="Right"
     Content="▶ 开始运行选中群组" Background="#0E7850"
     IsEnabled="False" Click="Start_Click" Padding="18,12"/>
  </DockPanel>
  <Grid Grid.Row="6">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="10"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <DockPanel Grid.Row="0">
    <TextBlock DockPanel.Dock="Left" Text="③ 正在运行及历史任务"
       FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="PauseButton" Content="暂停选中群" Click="Pause_Click"/>
     <Button x:Name="ResumeButton" Content="手动继续" Click="Resume_Click"
       Background="#126B52"/>
     <Button x:Name="StopButton" Content="停止选中群" Click="Stop_Click"
       Background="#8B4631"/>
    </StackPanel>
   </DockPanel>
   <DataGrid Grid.Row="2" x:Name="JobsGrid" IsReadOnly="True"
     AlternationCount="2" SelectionChanged="JobsGrid_SelectionChanged">
    <DataGrid.Columns>
     <DataGridTextColumn Header="剧本" Binding="{Binding ScriptName}" Width="1.5*"/>
     <DataGridTextColumn Header="群名" Binding="{Binding GroupName}" Width="1.5*"/>
     <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="105"/>
     <DataGridTextColumn Header="进度" Binding="{Binding Progress}" Width="85"/>
     <DataGridTextColumn Header="下一条" Binding="{Binding NextSend}" Width="155"/>
     <DataGridTextColumn Header="详情 / 异常" Binding="{Binding Detail}" Width="3*"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="8"
    Text="正在读取剧本、账号及群组……" Foreground="#BBD1E7" TextWrapping="Wrap"/>
 </Grid>
</Window>
