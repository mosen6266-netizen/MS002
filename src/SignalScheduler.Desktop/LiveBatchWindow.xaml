<UserControl x:Class="SignalScheduler.Desktop.LiveBatchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#091827" Foreground="#EAF4FD" MinWidth="620">
 <UserControl.Resources>
  <Style x:Key="PrimaryAction" TargetType="Button">
   <Setter Property="Background" Value="#2564C9"/>
   <Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#3576D5"/>
   <Setter Property="Padding" Value="17,11"/>
   <Setter Property="MinHeight" Value="42"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style x:Key="QuietAction" TargetType="Button" BasedOn="{StaticResource PrimaryAction}">
   <Setter Property="Background" Value="#1A334B"/>
   <Setter Property="BorderBrush" Value="#38566F"/>
   <Setter Property="Padding" Value="12,8"/>
  </Style>
  <Style x:Key="RunAction" TargetType="Button">
   <Setter Property="Background" Value="#16835D"/>
   <Setter Property="Foreground" Value="#F7FFFC"/>
   <Setter Property="BorderBrush" Value="#2DB98A"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="MinWidth" Value="195"/>
   <Setter Property="MinHeight" Value="48"/>
   <Setter Property="Padding" Value="22,12"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Background" Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
       CornerRadius="9" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center"
        VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Background" Property="Background" Value="#1B9A72"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Background" Property="Background" Value="#254258"/>
        <Setter TargetName="Background" Property="BorderBrush" Value="#3B5B73"/>
        <Setter Property="Foreground" Value="#AEC5D8"/>
        <Setter Property="Cursor" Value="Arrow"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="SmallJobAction" TargetType="Button" BasedOn="{StaticResource QuietAction}">
   <Setter Property="Padding" Value="7,5"/>
   <Setter Property="MinHeight" Value="34"/>
   <Setter Property="MinWidth" Value="54"/>
   <Setter Property="Margin" Value="2,0"/>
  </Style>
 </UserControl.Resources>
 <StackPanel Margin="24,22,24,28">
  <Grid Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="消息调度工作台" FontSize="25" FontWeight="SemiBold" Foreground="#F7FAFD"/>
    <TextBlock Text="一个页面完成选择、启动、监控和暂停。向下滚动查看运行详情。"
     FontSize="13" Foreground="#ABC3D9" Margin="0,7,0,0"/>
   </StackPanel>
   <Button Grid.Column="1" Content="↻ 刷新状态与列表" Click="Refresh_Click"
     Style="{StaticResource QuietAction}" VerticalAlignment="Center"/>
  </Grid>

  <Border Background="#11273C" CornerRadius="12" BorderBrush="#315068"
   BorderThickness="1" Padding="17" Margin="0,0,0,18">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/>
     <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Border Width="45" Height="45" CornerRadius="10" Background="#153F40">
     <TextBlock Text="✓" FontSize="24" FontWeight="Bold" Foreground="#67E5AF"
      HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="2" VerticalAlignment="Center">
     <TextBlock Text="账号连接概况" FontWeight="SemiBold" Foreground="#BBD0E0" FontSize="12"/>
     <TextBlock x:Name="AccountsSummary" Text="正在检查账号…" FontSize="17" FontWeight="SemiBold"
      Foreground="#F0F6FD" Margin="0,4,0,0"/>
    </StackPanel>
    <Button Grid.Column="3" Content="管理账号 →" Click="AccountsOpen_Click"
     VerticalAlignment="Center" Style="{StaticResource QuietAction}"/>
   </Grid>
  </Border>

  <Border Background="#11273C" BorderBrush="#315069" BorderThickness="1"
    CornerRadius="12" Padding="18" Margin="0,0,0,16">
   <StackPanel>
    <TextBlock Text="01 选择剧本与群组" FontSize="18" FontWeight="SemiBold" Foreground="#F4F7FC"/>
    <TextBlock Text="选择一个剧本，可同时勾选多个群组。" Foreground="#AAC5DB" Margin="0,7,0,12"/>
    <TextBlock Text="选择剧本" Foreground="#DBEAF8" Margin="0,0,0,6"/>
    <ComboBox x:Name="ScriptBox" TextSearch.TextPath="Name"
     SelectionChanged="ScriptBox_SelectionChanged" MinHeight="44"
     MaxDropDownHeight="350" Margin="0,0,0,18">
     <ComboBox.ItemTemplate>
      <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
       Foreground="#F5F9FF" ToolTip="{Binding Name}"/></DataTemplate>
     </ComboBox.ItemTemplate>
    </ComboBox>
    <Grid Margin="0,0,0,9">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="02 选择群组（最多 20 个）" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" Grid.Column="1">
      <Button Content="全选" Click="SelectAll_Click" Style="{StaticResource QuietAction}" Margin="0,0,7,0"/>
      <Button Content="清空" Click="ClearAll_Click" Style="{StaticResource QuietAction}"/>
     </StackPanel>
    </Grid>
    <DataGrid x:Name="GroupsGrid"
      SelectionChanged="GroupsGrid_SelectionChanged"
       AlternationCount="2" RowHeight="45"
      ColumnHeaderHeight="43" ColumnHeaderStyle="{StaticResource DarkGridHeader}"
      AutoGenerateColumns="False" Background="#12273B" Foreground="#F0F7FD"
      RowBackground="#12273B" AlternatingRowBackground="#1B344A"
      CanUserAddRows="False" IsReadOnly="False" BorderBrush="#3C5B73"
      ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="选择" Width="68">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           Style="{StaticResource LargeRowCheckBox}" ToolTip="点击选择或取消该群"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="群名称" Width="*">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <TextBlock Text="{Binding Name}" Foreground="#EDF6FD"
           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
           Margin="10,0" VerticalAlignment="Center" ToolTip="{Binding Name}"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="账号" Width="67" IsReadOnly="True"
        Binding="{Binding MemberAccounts}" ElementStyle="{StaticResource TruncatedGridText}"/>
      </DataGrid.Columns>
     </DataGrid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
     <Button x:Name="PreviousGroupsPage" Content="上一页" Click="PreviousGroupsPage_Click" Style="{StaticResource QuietAction}" Margin="0,0,8,0"/>
     <TextBlock x:Name="GroupsPageLabel" Text="第 1 / 1 页" VerticalAlignment="Center" Foreground="#EAF3FB" Margin="0,0,10,0"/>
     <Button x:Name="NextGroupsPage" Content="下一页" Click="NextGroupsPage_Click" Style="{StaticResource QuietAction}"/>
    </StackPanel>
   </StackPanel>
  </Border>
  <Border Background="#10273D" BorderBrush="#31516A" BorderThickness="1"
   CornerRadius="12" Padding="18" Margin="0,0,0,18">
   <StackPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="03 已选群组" FontSize="17" FontWeight="SemiBold" Foreground="#F2F7FD"/>
     <TextBlock x:Name="SelectedGroupCount" Grid.Column="1" Text="已选 0 个"
      Foreground="#8FE6C4" FontWeight="SemiBold"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,14,0,2">
     <CheckBox x:Name="ReadReceiptToggle" IsChecked="True"
      Content="新消息自动发送已读回执" FontSize="14" Foreground="#EFF6FD"
      Checked="ReadOptionsChanged" Unchecked="ReadOptionsChanged"
      Margin="0,0,26,0" ToolTip="接收新消息时请求发送已读回执；旧消息未必可以补发"/>
     <CheckBox x:Name="LinkedReadSyncToggle" IsChecked="True"
      Content="同步其他设备已读（实验）" FontSize="14" Foreground="#EFF6FD"
      Checked="ReadOptionsChanged" Unchecked="ReadOptionsChanged"
      ToolTip="目前仅保存此偏好，独立同步逻辑尚未接入；不能保证清零其他设备未读数"/>
    </StackPanel>
    <TextBlock Text="新消息已读回执开关重启后台后生效；设备同步开关暂存偏好，功能仍在开发。已读失败不影响发送。"
     FontSize="12" Foreground="#A9C3D9" Margin="0,8,0,5"/>
    <StackPanel Orientation="Horizontal" Margin="0,6,0,11">
     <Button Content="检查已读运行状态" Click="CheckReadHealth_Click"
      Style="{StaticResource QuietAction}" Margin="0,0,10,0"/>
     <TextBlock x:Name="ReadHealthLabel" Text="尚未检查消息监听状态"
      Foreground="#A9C3D9" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
    <ItemsControl x:Name="SelectedGroupTags" Margin="0,13,0,14">
     <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
     </ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border Background="#214565" BorderBrush="#3B7099" BorderThickness="1"
        CornerRadius="9" Margin="0,0,9,9" Padding="10,4">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <TextBlock Text="{Binding Name}" Foreground="#EFF6FD"
          TextTrimming="CharacterEllipsis" MaxWidth="190"
          VerticalAlignment="Center" ToolTip="{Binding Name}"/>
         <Button Content="×" Tag="{Binding GroupId}" Click="RemoveGroupTag_Click"
          Background="Transparent" BorderThickness="0" Foreground="#F2F7FC"
          FontWeight="Bold" FontSize="18" Padding="9,1" Margin="7,0,0,0"
          ToolTip="移除此群" Cursor="Hand"/>
        </StackPanel>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock VerticalAlignment="Center" Text="启动前会显示消息数量；旧版失效图片将先检查并提示处理方式。"
      Foreground="#B2C9DD" TextWrapping="Wrap" Margin="0,0,12,0"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="PreflightButton" Content="检查运行条件"
       Click="Preflight_Click" IsEnabled="False" Margin="0,0,10,0"
       Padding="15,10" Background="#244A66"
       ToolTip="只检查账号、群组、图片、授权和任务冲突，不会发送任何消息"/>
      <Button x:Name="StartButton" Content="▶ 启动选中群组"
       Style="{StaticResource RunAction}" Click="Start_Click" IsEnabled="False"
       ToolTip="请先选择剧本及至少一个群组，启动前会再次确认"/>
     </StackPanel>
    </Grid>
   </StackPanel>
  </Border>

  <Grid Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="04 运行中的任务与历史记录" FontSize="19"
     FontWeight="SemiBold" Foreground="#F5F8FD"/>
    <TextBlock Text="每个任务独立控制，运行状态刷新不打断滚动与选择"
      Margin="0,4,0,0" Foreground="#AFC7DD"/>
   </StackPanel>
   <TextBlock Grid.Column="1" Text="每行右侧直接操作" Foreground="#95B8D5"
    VerticalAlignment="Center"/>
  </Grid>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
   <Button x:Name="PreviousJobsPage" Content="上一页" Click="PreviousJobsPage_Click" Style="{StaticResource QuietAction}" Margin="0,0,8,0"/>
   <TextBlock x:Name="JobsPageLabel" Text="第 1 / 1 页" Foreground="#DCEAF8" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <Button x:Name="NextJobsPage" Content="下一页" Click="NextJobsPage_Click" Style="{StaticResource QuietAction}"/>
  </StackPanel>
  <DataGrid x:Name="JobsGrid" Height="440" Background="#112538"
   ColumnHeaderStyle="{StaticResource DarkGridHeader}" RowHeight="52"
   ColumnHeaderHeight="44" AlternationCount="2" Foreground="#EDF5FD"
   RowBackground="#142A3D" AlternatingRowBackground="#1B3147"
   AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
   SelectionChanged="JobsGrid_SelectionChanged">
   <DataGrid.Columns>
    <DataGridTextColumn Header="剧本" Width="1.2*" Binding="{Binding ScriptName}"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTextColumn Header="群组" Width="1.2*" Binding="{Binding GroupName}"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTextColumn Header="任务状态" Width="94" Binding="{Binding StateDisplay}"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTextColumn Header="当前阶段" Width="130" Binding="{Binding Phase}"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTextColumn Header="进度" Width="72" Binding="{Binding Progress}"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTextColumn Header="下句倒计时" Width="100" Binding="{Binding NextCountdown}"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTextColumn Header="剩余时间估算" Width="176" Binding="{Binding RemainingEstimate}"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTextColumn Header="最早完成时间" Width="172" Binding="{Binding EarliestFinish}"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTextColumn Header="下次发送" Width="130" Binding="{Binding NextSend}"
     ElementStyle="{StaticResource TruncatedGridText}"/>
    <DataGridTemplateColumn Header="详情" Width="1.4*">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <TextBlock Text="{Binding Detail}" Foreground="#C3D5E6"
        TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
        ToolTip="{Binding Detail}" VerticalAlignment="Center" Margin="8,0"/>
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTemplateColumn Header="操作" Width="194">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="暂停" Style="{StaticResource SmallJobAction}"
         IsEnabled="{Binding CanPause}" Click="JobPause_Click" Tag="{Binding}"/>
        <Button Content="继续" Style="{StaticResource SmallJobAction}"
         Background="#176F56" IsEnabled="{Binding CanResume}"
         Click="JobResume_Click" Tag="{Binding}"/>
        <Button Content="停止" Style="{StaticResource SmallJobAction}"
         Background="#8C4746" IsEnabled="{Binding CanStop}"
         Click="JobStop_Click" Tag="{Binding}"/>
       </StackPanel>
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock x:Name="StatusText" Text="正在读取剧本、账号及群组…"
   TextWrapping="Wrap" Foreground="#BAD0E2" Margin="1,13,1,4"
   FontSize="12"/>
 </StackPanel>
</UserControl>