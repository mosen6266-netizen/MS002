<UserControl x:Class="SignalScheduler.Desktop.LiveBatchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#0B1929" Foreground="#EDF5FD">
 <UserControl.Resources>
  <Style x:Key="HomeButton" TargetType="Button">
   <Setter Property="Background" Value="#193A53"/>
   <Setter Property="Foreground" Value="#F3F7FC"/>
   <Setter Property="BorderBrush" Value="#40627E"/>
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="MinHeight" Value="37"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style x:Key="RowActionButton" TargetType="Button"
   BasedOn="{StaticResource HomeButton}">
   <Setter Property="Padding" Value="5,5"/>
   <Setter Property="MinHeight" Value="34"/>
   <Setter Property="MinWidth" Value="57"/>
   <Setter Property="Margin" Value="2,0"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="10"/>
   <RowDefinition Height="88"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="224"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="8"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <DockPanel Grid.Row="0" LastChildFill="False">
   <StackPanel DockPanel.Dock="Left">
    <TextBlock Text="快速开始" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock Text="直接选择剧本和群组，开始或管理已获授权的群组通知任务"
     Foreground="#B0C8DC" FontSize="12" Margin="0,5,0,0"/>
   </StackPanel>
   <Button Content="↻ 刷新数据" DockPanel.Dock="Right" Click="Refresh_Click"
    Style="{StaticResource HomeButton}"/>
  </DockPanel>

  <Border Grid.Row="2" Background="#10283D" BorderBrush="#31546F"
   BorderThickness="1" CornerRadius="10" Padding="10">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,9">
     <TextBlock Text="账号运行状态" FontWeight="SemiBold" FontSize="15"/>
     <TextBlock x:Name="AccountsSummary" Text="正在读取账号…" Foreground="#B5D0E4"
      DockPanel.Dock="Right" Margin="16,0,0,0"/>
    </DockPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
      VerticalScrollBarVisibility="Disabled" CanContentScroll="True">
     <ItemsControl x:Name="AccountCards">
      <ItemsControl.ItemsPanel>
       <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border Background="#1A364D" BorderBrush="#345E78"
         BorderThickness="1" CornerRadius="7" Padding="10,5"
         MinWidth="130" MaxWidth="196" Height="43" Margin="0,0,8,0">
         <Grid>
          <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
           ToolTip="{Binding Detail}" Foreground="#F1F6FD" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{Binding Color}"
           FontSize="11" TextTrimming="CharacterEllipsis"/>
         </Grid>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Grid>
  </Border>

  <Border Grid.Row="4" Background="#102439" BorderBrush="#31516B"
   BorderThickness="1" CornerRadius="10" Padding="12">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="238"/><ColumnDefinition Width="14"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <TextBlock Text="① 选择剧本" FontSize="16" FontWeight="SemiBold"/>
     <ListBox x:Name="ScriptBox" Grid.Row="2" Height="162"
      SelectionChanged="ScriptBox_SelectionChanged"
      Background="#142C43" Foreground="#EFF5FC"
      BorderBrush="#406079" HorizontalContentAlignment="Stretch"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <TextBlock Text="{Binding Name}" TextWrapping="NoWrap"
         TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
         Foreground="#EDF6FF" VerticalAlignment="Center"/>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    <Grid Grid.Column="2">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <DockPanel Grid.Row="0">
      <TextBlock Text="② 选择群组（最多 20 个）"
       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button Content="全选" Click="SelectAll_Click" Style="{StaticResource HomeButton}"/>
       <Button Content="清空" Click="ClearAll_Click" Style="{StaticResource HomeButton}"/>
      </StackPanel>
     </DockPanel>
     <DataGrid x:Name="GroupsGrid" Grid.Row="2" AlternationCount="2"
      SelectionChanged="GroupsGrid_SelectionChanged"
      AutoGenerateColumns="False" CanUserAddRows="False"
      RowHeight="48" ColumnHeaderHeight="40"
      ColumnHeaderStyle="{StaticResource DarkGridHeader}"
      Background="#12283C" Foreground="#F0F6FD"
      RowBackground="#12283C" AlternatingRowBackground="#1C3249"
      IsReadOnly="False" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="选择" Width="78">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           HorizontalAlignment="Center" VerticalAlignment="Center"
           MinWidth="54" MinHeight="38" Padding="12,5" Cursor="Hand"
           ToolTip="勾选加入本次运行"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Signal 群名" Width="*">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <TextBlock Text="{Binding Name}" Foreground="#EAF4FD"
           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
           VerticalAlignment="Center" Margin="9,0" ToolTip="{Binding Name}"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="成员账号" Width="100" IsReadOnly="True"
        Binding="{Binding MemberAccounts}" ElementStyle="{StaticResource TruncatedGridText}"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Grid>
  </Border>

  <Grid Grid.Row="6">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <CheckBox x:Name="ConsentBox"
     Content="我确认已选群组允许发布此剧本的内容"
     Checked="Consent_Changed" Unchecked="Consent_Changed"
     FontWeight="SemiBold" MinHeight="39" Foreground="#EFF6FD"/>
    <TextBlock Text="发送异常会自动暂停并等待核对；关闭窗口不等于停止后台任务。"
     Foreground="#C3AC89" FontSize="11"/>
   </StackPanel>
   <Button x:Name="StartButton" Grid.Column="1" Content="▶ 开始运行"
    IsEnabled="False" Background="#107C56" BorderBrush="#2EA875"
    Foreground="White" Padding="24,12" MinWidth="160"
    Click="Start_Click" MinHeight="44"/>
  </Grid>

  <Grid Grid.Row="8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0">
    <TextBlock Text="③ 正在运行与历史任务" FontSize="16"
     FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock DockPanel.Dock="Right" Text="操作按钮在每条任务右侧，无需额外选中"
     VerticalAlignment="Center" Foreground="#B2C9DE" FontSize="12"/>
   </DockPanel>
   <DataGrid Grid.Row="2" x:Name="JobsGrid"
    AlternationCount="2" AutoGenerateColumns="False"
    CanUserAddRows="False" IsReadOnly="True"
    RowHeight="52" ColumnHeaderHeight="43"
    ColumnHeaderStyle="{StaticResource DarkGridHeader}"
    Foreground="#F1F6FD" Background="#102438"
    RowBackground="#152B40" AlternatingRowBackground="#1B3248"
    SelectionChanged="JobsGrid_SelectionChanged">
    <DataGrid.Columns>
     <DataGridTextColumn Header="剧本" Binding="{Binding ScriptName}" Width="1.2*"
       ElementStyle="{StaticResource TruncatedGridText}"/>
     <DataGridTextColumn Header="群名" Binding="{Binding GroupName}" Width="1.4*"
       ElementStyle="{StaticResource TruncatedGridText}"/>
     <DataGridTextColumn Header="状态" Binding="{Binding StateDisplay}" Width="91"
       ElementStyle="{StaticResource TruncatedGridText}"/>
     <DataGridTextColumn Header="进度" Binding="{Binding Progress}" Width="80"
       ElementStyle="{StaticResource TruncatedGridText}"/>
     <DataGridTextColumn Header="下一条" Binding="{Binding NextSend}" Width="95"
       ElementStyle="{StaticResource TruncatedGridText}"/>
     <DataGridTemplateColumn Header="详情 / 异常" Width="2*">
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
         Foreground="#C7D8EA" TextWrapping="NoWrap"
         ToolTip="{Binding Detail}" Margin="8,0" VerticalAlignment="Center"/>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTemplateColumn Header="任务操作" Width="204">
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
          HorizontalAlignment="Center">
         <Button Content="暂停" Style="{StaticResource RowActionButton}"
          IsEnabled="{Binding CanPause}" Tag="{Binding}"
          Click="JobPause_Click" ToolTip="暂停这一群的任务"/>
         <Button Content="继续" Style="{StaticResource RowActionButton}"
          Background="#17694F" IsEnabled="{Binding CanResume}"
          Tag="{Binding}" Click="JobResume_Click"
          ToolTip="手动恢复这一群"/>
         <Button Content="停止" Style="{StaticResource RowActionButton}"
          Background="#803E37" IsEnabled="{Binding CanStop}"
          Tag="{Binding}" Click="JobStop_Click"
          ToolTip="停止这一群的任务"/>
        </StackPanel>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="10"
   Text="读取账号状态与任务记录中…"
   TextTrimming="CharacterEllipsis" Foreground="#BFD3E5"
   ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
 </Grid>
</UserControl>