<UserControl x:Class="SignalScheduler.Desktop.LiveBatchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource Ui2Canvas}" Foreground="{StaticResource Ui2Text}">
 <UserControl.Resources>
  <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource ReadableButtonBase}">
   <Setter Property="Background" Value="#2D3035"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#41454B"/>
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style x:Key="QuietAction" TargetType="Button" BasedOn="{StaticResource PrimaryAction}">
   <Setter Property="Background" Value="#222529"/>
  </Style>
  <Style x:Key="RunAction" TargetType="Button" BasedOn="{StaticResource PrimaryAction}">
   <Setter Property="Background" Value="#117552"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="MinHeight" Value="42"/>
   <Setter Property="Padding" Value="19,8"/>
  </Style>
  <!-- Keep Chinese column labels centered with enough top/bottom room.
       Do not inherit the compact Windows default header metrics. -->
  <Style x:Key="ReadableGroupColumnHeader" TargetType="{x:Type DataGridColumnHeader}">
   <Setter Property="Background" Value="#2D3035"/>
   <Setter Property="Foreground" Value="#F4F9FF"/>
   <Setter Property="BorderBrush" Value="#41454B"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Padding" Value="10,8"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="MinHeight" Value="42"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="GroupNameAction" TargetType="Button" BasedOn="{StaticResource ReadableButtonBase}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Foreground" Value="#F1F2F4"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Padding" Value="8,0"/>
   <Setter Property="MinHeight" Value="0"/>
   <Setter Property="Height" Value="30"/>
   <Setter Property="Margin" Value="0,1"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="ToolTip" Value="点击群名即可勾选或取消勾选"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="#41454B"/>
    </Trigger>
    <DataTrigger Binding="{Binding Selected}" Value="True">
     <Setter Property="Background" Value="#454950"/>
     <Setter Property="BorderBrush" Value="#F1F2F4"/>
     <Setter Property="BorderThickness" Value="1"/>
     <Setter Property="Foreground" Value="#FFFFFF"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="SmallJobAction" TargetType="Button" BasedOn="{StaticResource QuietAction}">
   <Setter Property="Padding" Value="6,3"/>
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="Margin" Value="2,0"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="14,10,14,9" ClipToBounds="True">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="8"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="消息调度工作台" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock x:Name="AccountsSummary" Text="正在检查账号…" Foreground="#85DBBB"
     FontSize="13" Margin="0,4,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="管理账号" Style="{StaticResource QuietAction}" Click="AccountsOpen_Click"
     Margin="0,0,8,0"/>
    <Button Content="刷新" Style="{StaticResource QuietAction}" Click="Refresh_Click"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="55*" MinWidth="280"/>
    <ColumnDefinition Width="10"/>
    <ColumnDefinition Width="45*" MinWidth="260"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{StaticResource Ui2Surface}" BorderBrush="{StaticResource Ui2SurfaceHover}"
    BorderThickness="1" CornerRadius="9" Padding="8">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" MinHeight="76"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="7"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid Grid.Row="0" MinHeight="76" Margin="0,1,0,3">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto" MinHeight="29"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="01 选择群组（最多20个）"
       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
       TextWrapping="Wrap" Margin="3,0,0,0"
       ToolTip="选择群组（最多同时选择20个）"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
       Margin="0,7,0,0">
       <Button Content="全选20" Click="SelectAll_Click" Style="{StaticResource QuietAction}"
        MinHeight="28" Padding="8,3" Margin="0,0,5,0"/>
       <Button Content="清空" Click="ClearAll_Click" Style="{StaticResource QuietAction}"
        MinHeight="28" Padding="8,3"/>
      </StackPanel>
     </Grid>
     <TextBox x:Name="GroupSearchBox" Grid.Row="2" Height="32"
      VerticalContentAlignment="Center"
      TextChanged="GroupSearchBox_TextChanged" Background="{StaticResource Ui2SurfaceRaised}"
      Foreground="White" CaretBrush="White" Padding="8,4"
      ToolTip="输入群名筛选。切换页码不会清除勾选。"/>
     <DataGrid x:Name="GroupsGrid" Grid.Row="4" AutoGenerateColumns="False"
      CanUserAddRows="False" EnableColumnVirtualization="False"
      HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="36"
      ColumnHeaderStyle="{StaticResource ReadableGroupColumnHeader}"
      ColumnHeaderHeight="42" MinHeight="0"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      BorderBrush="{StaticResource Ui2BorderStrong}" Background="{StaticResource Ui2Surface}" Foreground="White"
      RowBackground="{StaticResource Ui2Surface}" AlternatingRowBackground="{StaticResource Ui2SurfaceRaised}"
      SelectionChanged="GroupsGrid_SelectionChanged">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="选择" Width="58" CanUserResize="False">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
           ToolTip="勾选该群组"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="群组名称" Width="*" MinWidth="150">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <Button Content="{Binding Name}" Tag="{Binding GroupId}"
           Click="ToggleGroupName_Click" Style="{StaticResource GroupNameAction}"
           ToolTip="{Binding Name}" HorizontalAlignment="Stretch"
           HorizontalContentAlignment="Left"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="账号数" Width="68" CanUserResize="False"
        Binding="{Binding MemberAccounts}" IsReadOnly="True"
        ElementStyle="{StaticResource TruncatedGridText}"/>
      </DataGrid.Columns>
     </DataGrid>
     <Grid Grid.Row="6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="GroupsPageLabel" Text="第 1/1 页" Foreground="{StaticResource Ui2TextSecondary}"
       VerticalAlignment="Center" FontSize="12"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <Button x:Name="PreviousGroupsPage" Content="上一页" Click="PreviousGroupsPage_Click"
        Style="{StaticResource QuietAction}" MinHeight="26" Padding="8,3" Margin="0,0,6,0"/>
       <Button x:Name="NextGroupsPage" Content="下一页" Click="NextGroupsPage_Click"
        Style="{StaticResource QuietAction}" MinHeight="26" Padding="8,3"/>
      </StackPanel>
     </Grid>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="{StaticResource Ui2Surface}" BorderBrush="{StaticResource Ui2SurfaceHover}"
    BorderThickness="1" CornerRadius="9" Padding="14">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="9"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <TextBlock Text="02 选择剧本" FontSize="16" FontWeight="SemiBold"/>
     <ComboBox x:Name="ScriptBox" Grid.Row="2" MinHeight="40"
      TextSearch.TextPath="Name" MaxDropDownHeight="300"
      SelectionChanged="ScriptBox_SelectionChanged">
      <ComboBox.ItemTemplate><DataTemplate>
       <TextBlock Text="{Binding Name}" Foreground="#F2F8FD"
        TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
      </DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="03 本次发送目标" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock x:Name="SelectedGroupCount" Grid.Column="1" Text="已选 0 / 20 个"
       FontWeight="SemiBold" Foreground="#8FE4BD" VerticalAlignment="Center"/>
     </Grid>
     <CheckBox x:Name="ReadReceiptToggle" Grid.Row="6"
      Content="发言前仅当前账号已读群消息" IsChecked="True"
      Checked="ReadOptionsChanged" Unchecked="ReadOptionsChanged"
      Foreground="{StaticResource Ui2Text}" FontSize="13"
      ToolTip="启用后仅当剧本轮到某账号发送时，由该账号尝试已读当前群的待处理消息；其他账号保持未读"/>
     <CheckBox x:Name="LinkedReadSyncToggle" Visibility="Collapsed"
      IsChecked="False" IsEnabled="False" Grid.Row="7"/>
     <StackPanel Grid.Row="7" VerticalAlignment="Center">
      <Button Content="检查已读状态" Style="{StaticResource QuietAction}"
       HorizontalAlignment="Left" Click="CheckReadHealth_Click" Margin="0,0,0,7"/>
      <TextBlock x:Name="ReadHealthLabel" Text="已读回执仅在当前账号准备发言前发送"
       TextWrapping="Wrap" Foreground="{StaticResource Ui2TextSecondary}" FontSize="11" MaxHeight="70"/>
     </StackPanel>
     <StackPanel Grid.Row="8">
      <Button x:Name="PreflightButton" Content="检查运行条件" Click="Preflight_Click"
       Style="{StaticResource QuietAction}" Margin="0,0,0,7"/>
      <Button x:Name="StartButton" Content="▶ 启动选中群组"
       Click="Start_Click" Style="{StaticResource RunAction}"/>
     </StackPanel>
     <ItemsControl x:Name="SelectedGroupTags" Visibility="Collapsed"/>
    </Grid>
   </Border>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="3" Text="正在读取本地账号、群组和剧本…"
   TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ui2TextSecondary}" FontSize="11" Margin="2,4,2,0"/>
 </Grid>
</UserControl>