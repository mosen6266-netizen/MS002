<UserControl x:Class="SignalScheduler.Desktop.LiveBatchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#091827" Foreground="#EAF4FD">
 <UserControl.Resources>
  <Style x:Key="PrimaryAction" TargetType="Button">
   <Setter Property="Background" Value="#245477"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#3B6E90"/>
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style x:Key="QuietAction" TargetType="Button" BasedOn="{StaticResource PrimaryAction}">
   <Setter Property="Background" Value="#1A344C"/>
  </Style>
  <Style x:Key="RunAction" TargetType="Button" BasedOn="{StaticResource PrimaryAction}">
   <Setter Property="Background" Value="#117552"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="MinHeight" Value="42"/>
   <Setter Property="Padding" Value="19,8"/>
  </Style>
  <Style x:Key="SmallJobAction" TargetType="Button" BasedOn="{StaticResource QuietAction}">
   <Setter Property="Padding" Value="6,3"/>
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="Margin" Value="2,0"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="14,10,14,9" ClipToBounds="True">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="8"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="9"/>
   <RowDefinition Height="115"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="消息调度工作台" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock x:Name="AccountsSummary" Text="正在检查账号…" Foreground="#85DBBB"
     FontSize="13" Margin="0,4,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="管理账号" Style="{StaticResource QuietAction}" Click="AccountsOpen_Click"
     Margin="0,0,8,0"/>
    <Button Content="刷新" Style="{StaticResource QuietAction}" Click="Refresh_Click"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="55*" MinWidth="280"/>
    <ColumnDefinition Width="10"/>
    <ColumnDefinition Width="45*" MinWidth="260"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#12293E" BorderBrush="#34526D"
    BorderThickness="1" CornerRadius="9" Padding="11">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="7"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="7"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="7"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="01 选择群组（最多20个）" FontSize="16" FontWeight="SemiBold"
       VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <Button Content="全选20" Click="SelectAll_Click" Style="{StaticResource QuietAction}"
        Margin="0,0,5,0"/>
       <Button Content="清空" Click="ClearAll_Click" Style="{StaticResource QuietAction}"/>
      </StackPanel>
     </Grid>
     <TextBox x:Name="GroupSearchBox" Grid.Row="2" Height="32"
      TextChanged="GroupSearchBox_TextChanged" Background="#1B3A53"
      Foreground="White" CaretBrush="White" Padding="8,4"
      ToolTip="输入群名筛选。切换页码不会清除勾选。"/>
     <DataGrid x:Name="GroupsGrid" Grid.Row="4" AutoGenerateColumns="False"
      CanUserAddRows="False" EnableColumnVirtualization="False"
      HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="29"
      ColumnHeaderHeight="31" MinHeight="0"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      BorderBrush="#34546F" Background="#11283E" Foreground="White"
      RowBackground="#142D43" AlternatingRowBackground="#1A344B"
      SelectionChanged="GroupsGrid_SelectionChanged">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="选择" Width="58" CanUserResize="False">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
           ToolTip="勾选该群组"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="群组名称" Width="*" MinWidth="150">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
           Foreground="#F1F7FD" Margin="8,0" VerticalAlignment="Center"
           ToolTip="{Binding Name}"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="账号数" Width="68" CanUserResize="False"
        Binding="{Binding MemberAccounts}" IsReadOnly="True"
        ElementStyle="{StaticResource TruncatedGridText}"/>
      </DataGrid.Columns>
     </DataGrid>
     <Grid Grid.Row="6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="GroupsPageLabel" Text="第 1/1 页" Foreground="#BBD5E8"
       VerticalAlignment="Center" FontSize="12"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <Button x:Name="PreviousGroupsPage" Content="上一页" Click="PreviousGroupsPage_Click"
        Style="{StaticResource QuietAction}" Margin="0,0,6,0"/>
       <Button x:Name="NextGroupsPage" Content="下一页" Click="NextGroupsPage_Click"
        Style="{StaticResource QuietAction}"/>
      </StackPanel>
     </Grid>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="#12293E" BorderBrush="#34526D"
    BorderThickness="1" CornerRadius="9" Padding="14">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="9"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <TextBlock Text="02 选择剧本" FontSize="16" FontWeight="SemiBold"/>
     <ComboBox x:Name="ScriptBox" Grid.Row="2" MinHeight="40"
      TextSearch.TextPath="Name" MaxDropDownHeight="300"
      SelectionChanged="ScriptBox_SelectionChanged">
      <ComboBox.ItemTemplate><DataTemplate>
       <TextBlock Text="{Binding Name}" Foreground="#F2F8FD"
        TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
      </DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="03 本次发送目标" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock x:Name="SelectedGroupCount" Grid.Column="1" Text="已选 0 / 20 个"
       FontWeight="SemiBold" Foreground="#8FE4BD" VerticalAlignment="Center"/>
     </Grid>
     <CheckBox x:Name="ReadReceiptToggle" Grid.Row="6"
      Content="自动发送新消息已读回执" IsChecked="True"
      Checked="ReadOptionsChanged" Unchecked="ReadOptionsChanged"
      Foreground="#EAF5FE" FontSize="13"
      ToolTip="后台自动监听并处理新收到的消息，不要求先发送群消息"/>
     <CheckBox x:Name="LinkedReadSyncToggle" Visibility="Collapsed"
      IsChecked="False" IsEnabled="False" Grid.Row="7"/>
     <StackPanel Grid.Row="7" VerticalAlignment="Center">
      <Button Content="检查已读状态" Style="{StaticResource QuietAction}"
       HorizontalAlignment="Left" Click="CheckReadHealth_Click" Margin="0,0,0,7"/>
      <TextBlock x:Name="ReadHealthLabel" Text="已读监听状态可在这里检查"
       TextWrapping="Wrap" Foreground="#A9C8E0" FontSize="11" MaxHeight="70"/>
     </StackPanel>
     <StackPanel Grid.Row="8">
      <Button x:Name="PreflightButton" Content="检查运行条件" Click="Preflight_Click"
       Style="{StaticResource QuietAction}" Margin="0,0,0,7"/>
      <Button x:Name="StartButton" Content="▶ 启动选中群组"
       Click="Start_Click" Style="{StaticResource RunAction}"/>
     </StackPanel>
     <ItemsControl x:Name="SelectedGroupTags" Visibility="Collapsed"/>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="4" Background="#10273C" BorderBrush="#34526D"
   BorderThickness="1" CornerRadius="8" Padding="8">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="当前运行任务（完整详情在左侧「运行任务」）"
      FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="PreviousJobsPage" Content="上一页" Click="PreviousJobsPage_Click"
       Style="{StaticResource QuietAction}" MinHeight="27" Padding="8,2" Margin="0,0,5,0"/>
      <TextBlock x:Name="JobsPageLabel" Text="第1页" VerticalAlignment="Center"
       FontSize="11" Foreground="#AAC9DD" Margin="0,0,5,0"/>
      <Button x:Name="NextJobsPage" Content="下一页" Click="NextJobsPage_Click"
       Style="{StaticResource QuietAction}" MinHeight="27" Padding="8,2"/>
     </StackPanel>
    </Grid>
    <DataGrid x:Name="JobsGrid" Grid.Row="1" AutoGenerateColumns="False"
     IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"
     RowHeight="30" ColumnHeaderHeight="26" EnableColumnVirtualization="False"
     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
     ScrollViewer.VerticalScrollBarVisibility="Disabled"
     Background="#11263A" Foreground="White"
     SelectionChanged="JobsGrid_SelectionChanged">
     <DataGrid.Columns>
      <DataGridTextColumn Header="群组" Width="2*" MinWidth="110"
       Binding="{Binding GroupName}" ElementStyle="{StaticResource TruncatedGridText}"/>
      <DataGridTextColumn Header="状态" Width="115"
       Binding="{Binding StateDisplay}" ElementStyle="{StaticResource TruncatedGridText}"/>
      <DataGridTextColumn Header="进度" Width="82"
       Binding="{Binding Progress}" ElementStyle="{StaticResource TruncatedGridText}"/>
      <DataGridTextColumn Header="下句等待" Width="110"
       Binding="{Binding NextCountdown}" ElementStyle="{StaticResource TruncatedGridText}"/>
      <DataGridTemplateColumn Header="操作" Width="186">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <StackPanel Orientation="Horizontal">
          <Button Content="暂停" Style="{StaticResource SmallJobAction}"
           Tag="{Binding}" Click="JobPause_Click" IsEnabled="{Binding CanPause}"/>
          <Button Content="继续" Style="{StaticResource SmallJobAction}"
           Tag="{Binding}" Click="JobResume_Click" IsEnabled="{Binding CanResume}"/>
          <Button Content="停止" Style="{StaticResource SmallJobAction}"
           Tag="{Binding}" Click="JobStop_Click" IsEnabled="{Binding CanStop}"/>
         </StackPanel>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </Border>
  <TextBlock x:Name="StatusText" Grid.Row="5" Text="正在读取本地账号、群组和剧本…"
   TextTrimming="CharacterEllipsis" Foreground="#B7D1E5" FontSize="11" Margin="2,4,2,0"/>
 </Grid>
</UserControl>