<UserControl x:Class="SignalScheduler.Desktop.HistoryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#091827" Foreground="#F0F6FD">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="2*"/><RowDefinition Height="14"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
   <RowDefinition Height="2*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel>
   <StackPanel DockPanel.Dock="Left">
    <TextBlock Text="历史运行记录" FontSize="22" FontWeight="Bold"/>
    <TextBlock Text="查看已完成、已停止和失败的剧本任务；点击记录核对每条发送结果。"
     Foreground="#9FC0DB" Margin="0,6,0,0"/>
   </StackPanel>
   <Button Content="刷新历史" DockPanel.Dock="Right" Click="Refresh_Click"
    Background="#225277" Foreground="#F0F6FD" Padding="16,8"/>
  </DockPanel>
  <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"
   Margin="0,8,0,10">
   <TextBox x:Name="HistorySearchBox" Width="210" Margin="0,0,8,6"
    ToolTip="搜索群名或剧本名称" TextChanged="FiltersChanged"/>
   <ComboBox x:Name="HistoryStateBox" Width="130" Margin="0,0,8,6"
    SelectionChanged="FiltersChanged">
    <ComboBoxItem Content="全部状态" Tag=""/>
    <ComboBoxItem Content="已完成" Tag="Completed"/>
    <ComboBoxItem Content="已停止" Tag="Stopped"/>
    <ComboBoxItem Content="异常停止" Tag="Failed"/>
   </ComboBox>
   <Button Content="查询" Click="Refresh_Click" Padding="10,4" Margin="0,0,8,6"/>
   <Button Content="导出所选明细 JSON" Click="ExportSelected_Click"
    Padding="10,4" Margin="0,0,8,6" ToolTip="导出当前选中任务的全部消息及结果，包含消息正文"/>
   <Button x:Name="HistoryPrevButton" Content="上一页" Click="PreviousPage_Click"
    Margin="0,0,6,6" Padding="10,4"/>
   <TextBlock x:Name="HistoryPageLabel" Text="第 1 / 1 页" VerticalAlignment="Center"
    Margin="0,0,6,6" Foreground="#DCEAF8"/>
   <Button x:Name="HistoryNextButton" Content="下一页" Click="NextPage_Click" Padding="10,4" Margin="0,0,0,6"/>
  </WrapPanel>
  <DataGrid x:Name="HistoryGrid" Grid.Row="2"
   EnableColumnVirtualization="False" HeadersVisibility="Column"
   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
   SelectionChanged="HistoryGrid_SelectionChanged"
   AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
   RowHeight="43" ColumnHeaderHeight="40"
   Background="#132B41" Foreground="#F0F6FD"
   RowBackground="#132B41" AlternatingRowBackground="#1B344A">
   <DataGrid.Columns>
    <DataGridTextColumn Header="群名" Binding="{Binding GroupName}" Width="2*" MinWidth="100"/>
    <DataGridTextColumn Header="剧本" Binding="{Binding ScriptName}" Width="2*" MinWidth="100"/>
    <DataGridTextColumn Header="状态" Binding="{Binding StateDisplay}" Width="*" MinWidth="85"/>
    <DataGridTextColumn Header="已执行进度" Binding="{Binding Progress}" Width="*" MinWidth="90"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="4" Text="发送明细 · 消息全文及结果" FontSize="18" FontWeight="SemiBold"/>
  <DataGrid x:Name="MessagesGrid" Grid.Row="6"
   EnableColumnVirtualization="False" HeadersVisibility="Column"
   ScrollViewer.HorizontalScrollBarVisibility="Auto"
   AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
   RowHeight="42" ColumnHeaderHeight="36" Background="#10263A"
   Foreground="#EDF5FD" RowBackground="#132B41" AlternatingRowBackground="#1B344A">
   <DataGrid.Columns>
    <DataGridTextColumn Header="序号" Binding="{Binding Position}" Width="50"/>
    <DataGridTextColumn Header="账号备注" Binding="{Binding AccountLabel}" Width="115"/>
    <DataGridTextColumn Header="发表内容" Binding="{Binding Content}" Width="3*" MinWidth="120"/>
    <DataGridTextColumn Header="发送结果" Binding="{Binding State}" Width="100"/>
    <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="2*" MinWidth="105"/>
    <DataGridTextColumn Header="发送时间" Binding="{Binding SentAt}" Width="145"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock x:Name="StatusText" Grid.Row="7" Margin="0,12,0,0"
   Foreground="#A9C8E0" TextWrapping="Wrap"
   Text="正在读取历史记录…"/>
 </Grid>
</UserControl>