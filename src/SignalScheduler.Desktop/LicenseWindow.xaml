<UserControl x:Class="SignalScheduler.Desktop.LicenseWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#091928" Foreground="#EEF5FF">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#193B59"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#3E607D"/>
   <Setter Property="Padding" Value="15,9"/>
   <Setter Property="Margin" Value="0,0,12,0"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="16"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="18"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="18"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock Text="卡密授权管理" FontSize="26" FontWeight="Bold"/>
  <Border Grid.Row="2" Background="#102A40" BorderBrush="#315371"
   BorderThickness="1" CornerRadius="10" Padding="16">
   <StackPanel>
    <TextBlock Text="当前授权状态" FontSize="17" FontWeight="SemiBold"
     Margin="0,0,0,12"/>
    <TextBlock x:Name="StateText" Text="正在检查…" FontSize="21"
     FontWeight="SemiBold" Foreground="#F3C46F"/>
    <TextBlock x:Name="TypeText" Text="卡密类型：—" Margin="0,9,0,0"/>
    <TextBlock x:Name="ExpiryText" Text="到期时间：—" Margin="0,5,0,0"/>
    <TextBlock x:Name="DetailText" Text="" Foreground="#B4CBE1"
     Margin="0,10,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <StackPanel Grid.Row="4">
   <TextBlock Text="输入已有卡密或新卡密" FontSize="16" FontWeight="SemiBold"/>
   <PasswordBox x:Name="KeyBox" Margin="0,10,0,0" Background="#102A40"
    Foreground="White" BorderBrush="#395D79" Padding="12"/>
   <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
    <Button Content="激活 / 绑定到这台电脑" Click="Activate_Click"
     Background="#147752"/>
    <Button Content="重新联网检查" Click="Check_Click"/>
   </StackPanel>
  </StackPanel>
  <TextBlock Grid.Row="6"
   Text="注意：首次激活可能立即开始计算卡密有效期；每张卡有设备绑定上限。重新安装通常会保留本地加密授权资料。旧版本已绑定的卡如提示设备数量已满，需由后台管理员确认后解绑，程序不会私自解除其他设备绑定。"
   TextWrapping="Wrap" Foreground="#F3C080" VerticalAlignment="Top"/>
  <TextBlock Grid.Row="7" x:Name="FeedbackText"
   Text="授权校验使用现有 Cloudflare 后台，卡密使用 Windows 当前用户加密保存。"
   Foreground="#AFC7E0" TextWrapping="Wrap"/>
 </Grid>
</UserControl>